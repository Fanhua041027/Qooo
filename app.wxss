page {
  --qd-primary: #25666d;
  --qd-primary-strong: #174b51;
  --qd-primary-soft: #e5f1f2;
  --qd-accent: #b65e18;
  --qd-accent-soft: #fff0e2;
  --qd-bg: #f6f8f8;
  --qd-surface: #ffffff;
  --qd-surface-subtle: #eef3f3;
  --qd-ink: #172b2e;
  --qd-ink-secondary: #465f62;
  --qd-border: #d8e2e3;
  --qd-success: #277a4c;
  --qd-success-soft: #e4f4ea;
  --qd-warning: #9b5b12;
  --qd-warning-soft: #fff2d9;
  --qd-danger: #b63f37;
  --qd-danger-soft: #fde9e7;
  --qd-info: #2868a8;
  --qd-info-soft: #e7f1fb;
  --qd-radius-sm: 12rpx;
  --qd-radius-md: 20rpx;
  --qd-radius-lg: 28rpx;
  min-height: 100%;
  background: var(--qd-bg);
  color: var(--qd-ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.55;
}

button,
input,
textarea { font: inherit; }
button::after { border: 0; }

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(152rpx + env(safe-area-inset-bottom));
}
.page-scroll { height: calc(100vh - 88rpx - env(safe-area-inset-top)); }
.page-content { padding: 28rpx 32rpx 48rpx; }
.page-content--with-cta { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.section { margin-top: 40rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 20rpx; }
.section-title { color: var(--qd-ink); font-size: 34rpx; line-height: 1.3; font-weight: 650; }
.section-link { min-height: 48rpx; color: var(--qd-primary); font-size: 26rpx; line-height: 48rpx; }
.surface { background: var(--qd-surface); border: 1rpx solid var(--qd-border); border-radius: var(--qd-radius-md); }
.surface-pressed { background: var(--qd-surface-subtle); }
.body-text { color: var(--qd-ink-secondary); font-size: 29rpx; line-height: 1.65; }
.caption { color: var(--qd-ink-secondary); font-size: 25rpx; line-height: 1.5; }
.divider { height: 1rpx; background: var(--qd-border); }
.fixed-cta { position: fixed; z-index: 30; right: 0; bottom: 0; left: 0; padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, 0.97); border-top: 1rpx solid var(--qd-border); }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
