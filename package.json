{
  "name": "nongjianzhen-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "农间诊微信小程序前端",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content:validate": "node scripts/validate-agriculture-content.mjs",
    "content:validate:approved": "node scripts/validate-agriculture-content.mjs --require-approved",
    "qa:smoke:p0-11": "node scripts/qa/smoke-p0-11.mjs",
    "qa:init:p0-11": "node scripts/qa/init-p0-11-data.mjs",
    "qa:reset:p0-11": "node scripts/qa/reset-p0-11-data.mjs",
    "release:check": "node scripts/release/check-release.mjs",
    "release:check:code": "node scripts/release/check-release.mjs --code-only"
  },
  "dependencies": {
    "@nongjianzhen/api-client": "workspace:*",
    "@nongjianzhen/diagnosis-engine": "workspace:*",
    "@nongjianzhen/types": "workspace:*",
    "@tarojs/components": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "7.27.1",
    "@esbuild/win32-x64": "0.18.20",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "24.5.2",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "babel-preset-taro": "4.2.1",
    "react-refresh": "^0.14.2",
    "sass": "1.93.2",
    "typescript": "5.9.2",
    "vite": "4.5.14",
    "vitest": "0.34.6"
  },
  "engines": {
    "node": ">=20"
  }
}
