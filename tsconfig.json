{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@nongjianzhen/types": ["packages/types/src/index.ts"],
      "@nongjianzhen/api-client": ["packages/api-client/src/index.ts"],
      "@nongjianzhen/diagnosis-engine": ["packages/diagnosis-engine/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["src", "config", "packages", "vitest.config.ts"]
}
