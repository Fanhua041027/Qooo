<view class="empty-state" aria-role="group" aria-label="{{title}}">
  <view class="empty-state__visual empty-state__visual--{{type}}" aria-hidden="true"><view class="empty-state__line"></view><view class="empty-state__dot"></view></view>
  <view class="empty-state__title">{{title}}</view>
  <view wx:if="{{description}}" class="empty-state__description">{{description}}</view>
  <view wx:if="{{action}}" class="empty-state__action"><qd-button label="{{action}}" type="secondary" size="medium" block="{{false}}" bind:tap="handleAction" /></view>
</view>
