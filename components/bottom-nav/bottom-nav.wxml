<view class="bottom-nav" aria-role="navigation" aria-label="主导航">
  <view wx:for="{{items}}" wx:key="key" class="bottom-nav__item {{current === item.key ? 'bottom-nav__item--active' : ''}}" data-key="{{item.key}}" bindtap="change" hover-class="bottom-nav__item--pressed" aria-role="button" aria-label="{{item.label}}">
    <view class="bottom-nav__icon bottom-nav__icon--{{item.key}}" aria-hidden="true"></view><text>{{item.label}}</text>
  </view>
</view>
