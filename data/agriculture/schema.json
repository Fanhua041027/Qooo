{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nongjianzhen.local/schemas/agriculture-issue-v1.json",
  "title": "农间诊农业问题条目",
  "type": "object",
  "required": ["version", "issues"],
  "properties": {
    "version": { "type": "string" },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "crop", "problem", "category", "riskLevel", "symptoms",
        "possibleCauses", "captureParts", "actionWindow", "recommendedActions",
        "doNot", "safeInterval", "expertReview", "plainLanguage", "aiReview", "sourceRefs"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "crop": { "enum": ["番茄", "黄瓜", "水稻", "玉米", "柑橘"] },
        "problem": { "type": "string", "minLength": 2 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "category": { "enum": ["disease", "pest", "physiological", "nutrient"] },
        "riskLevel": { "enum": ["low", "medium", "high", "critical"] },
        "symptoms": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "possibleCauses": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "lookalikes": { "type": "array", "items": { "type": "string" } },
        "captureParts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "actionWindow": { "type": "string" },
        "recommendedActions": {
          "type": "object",
          "required": ["immediate", "followUp", "chemicalBoundary"],
          "properties": {
            "immediate": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "followUp": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "chemicalBoundary": { "type": "string" }
          }
        },
        "doNot": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "safeInterval": {
          "type": "object",
          "required": ["policy", "displayText"],
          "properties": {
            "policy": { "enum": ["not_applicable", "label_required"] },
            "displayText": { "type": "string" }
          }
        },
        "expertReview": {
          "type": "object",
          "required": ["recommended", "triggers"],
          "properties": {
            "recommended": { "type": "boolean" },
            "triggers": { "type": "array", "items": { "type": "string" } }
          }
        },
        "plainLanguage": {
          "type": "object",
          "required": ["shortName", "summary", "nextStep"],
          "properties": {
            "shortName": { "type": "string" },
            "summary": { "type": "string" },
            "nextStep": { "type": "string" }
          }
        },
        "aiReview": {
          "type": "object",
          "required": ["requiredEvidence", "rejectIf", "confidenceCap"],
          "properties": {
            "requiredEvidence": { "type": "array", "items": { "type": "string" } },
            "rejectIf": { "type": "array", "items": { "type": "string" } },
            "confidenceCap": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}

