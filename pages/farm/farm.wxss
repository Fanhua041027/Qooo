.farm-empty { margin-top: 36rpx; }.farm-overview { padding: 30rpx; color: #fff; background: var(--qd-primary-strong); border-radius: 24rpx; }.farm-overview__top { display: flex; justify-content: space-between; gap: 20rpx; }.farm-overview__name { font-size: 38rpx; font-weight: 720; }.farm-overview__location { margin-top: 5rpx; color: rgba(255,255,255,.74); font-size: 25rpx; }.farm-overview__edit { min-width: 88rpx; min-height: 60rpx; color: #fff; background: rgba(255,255,255,.14); border-radius: 999rpx; line-height: 60rpx; text-align: center; font-size: 24rpx; }.health-summary { display: flex; align-items: center; gap: 22rpx; margin-top: 36rpx; }.health-summary__score { font-size: 64rpx; line-height: 1; font-weight: 750; }.health-summary__title { font-weight: 680; }.health-summary__desc { margin-top: 4rpx; color: rgba(255,255,255,.75); font-size: 24rpx; }.health-bar { height: 10rpx; margin-top: 20rpx; overflow: hidden; background: rgba(255,255,255,.2); border-radius: 10rpx; }.health-bar view { width: 82%; height: 100%; background: #fff; border-radius: 10rpx; }.plot-list { display: flex; flex-direction: column; gap: 20rpx; }.plot-card { padding: 22rpx; }.plot-card__head { display: flex; justify-content: space-between; gap: 18rpx; }.plot-card__name { font-size: 31rpx; font-weight: 680; }.plot-card__field { position: relative; height: 150rpx; margin-top: 20rpx; overflow: hidden; background: #dcebe6; border-radius: 16rpx; }.plot-card__rows { position: absolute; width: 430rpx; height: 190rpx; left: -20rpx; top: 68rpx; border: 5rpx solid #559079; border-radius: 50%; }.plot-card__rows::before, .plot-card__rows::after { content: ''; position: absolute; width: 430rpx; height: 190rpx; top: -28rpx; border: 5rpx solid #559079; border-radius: 50%; }.plot-card__rows::after { top: -56rpx; }.plot-card__crop { position: absolute; right: 44rpx; top: 26rpx; width: 50rpx; height: 76rpx; background: #3c7955; border-radius: 50rpx 4rpx 50rpx 4rpx; }.plot-card__footer { display: flex; justify-content: space-between; gap: 18rpx; margin-top: 18rpx; color: var(--qd-ink-secondary); font-size: 24rpx; }.plot-card__footer view:last-child { color: var(--qd-primary); font-weight: 650; }.farm-timeline { margin-top: 20rpx; }.farm-timeline > view { display: flex; gap: 20rpx; min-height: 100rpx; }.farm-timeline > view > text { flex: none; width: 130rpx; color: var(--qd-ink-secondary); font-size: 23rpx; }.farm-timeline > view > view { position: relative; flex: 1; padding-left: 26rpx; border-left: 2rpx solid #bccdce; }.farm-timeline > view > view::before { content: ''; position: absolute; width: 14rpx; height: 14rpx; left: -8rpx; top: 6rpx; background: var(--qd-primary); border-radius: 50%; }.farm-timeline > view > view > view { font-size: 28rpx; font-weight: 650; }.farm-timeline > view > view > text { color: var(--qd-ink-secondary); font-size: 24rpx; }
.farm-editor-mask { position: fixed; z-index: 50; inset: 0; background: rgba(15, 29, 31, .42); }
.farm-editor { position: fixed; z-index: 60; right: 0; bottom: 0; left: 0; padding: 30rpx 32rpx calc(30rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 24rpx 24rpx 0 0; }
.farm-editor__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }.farm-editor__title { font-size: 34rpx; font-weight: 700; }.farm-editor__close { width: 64rpx; height: 64rpx; color: var(--qd-ink-secondary); background: var(--qd-surface-subtle); border-radius: 50%; font-size: 40rpx; line-height: 60rpx; text-align: center; }
.farm-editor__field { margin-top: 16rpx; }.farm-editor__field > text { display: block; margin-bottom: 8rpx; color: var(--qd-ink-secondary); font-size: 24rpx; font-weight: 600; }.farm-editor__field input { width: 100%; min-height: 76rpx; padding: 16rpx 20rpx; box-sizing: border-box; background: var(--qd-surface-subtle); border-radius: 14rpx; font-size: 28rpx; }.farm-editor__actions { display: flex; gap: 16rpx; margin-top: 26rpx; }.farm-editor__actions qd-button:first-child { flex: 0 0 30%; }.farm-editor__actions qd-button:last-child { flex: 1; }
