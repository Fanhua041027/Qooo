.states-intro { padding: 22rpx 24rpx; color: var(--qd-primary-strong); background: var(--qd-primary-soft); border-radius: 18rpx; font-size: 27rpx; line-height: 1.65; }.states-group { margin-top: 36rpx; }.states-list { margin-top: 18rpx; overflow: hidden; }.states-row { display: flex; align-items: center; justify-content: space-between; min-height: 94rpx; padding: 0 22rpx; box-sizing: border-box; }.states-row + .states-row { border-top: 1rpx solid var(--qd-border); }.states-row text:first-child { font-size: 28rpx; font-weight: 580; }.states-row text:last-child { color: var(--qd-primary); font-size: 40rpx; font-weight: 300; }.states-note { margin: 34rpx 0; color: var(--qd-ink-secondary); font-size: 25rpx; line-height: 1.65; }
