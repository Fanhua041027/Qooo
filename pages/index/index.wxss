.offline-banner { display: flex; align-items: center; gap: 18rpx; min-height: 88rpx; margin-bottom: 24rpx; padding: 14rpx 18rpx; box-sizing: border-box; color: #87302b; background: var(--qd-danger-soft); border-radius: 16rpx; }
.offline-banner__mark { display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border: 3rpx solid currentColor; border-radius: 50%; font-weight: 800; }
.offline-banner__copy { flex: 1; display: flex; flex-direction: column; font-size: 24rpx; line-height: 1.5; }.offline-banner__copy text:first-child { font-weight: 700; }.offline-banner__action { min-width: 72rpx; min-height: 56rpx; line-height: 56rpx; text-align: center; font-weight: 650; }
.home-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 24rpx; }
.home-head__greeting { font-size: 39rpx; font-weight: 720; line-height: 1.25; }.home-head__date { margin-top: 10rpx; color: var(--qd-ink-secondary); font-size: 25rpx; }
.weather-chip { display: flex; flex-direction: column; align-items: flex-end; min-width: 96rpx; color: var(--qd-ink-secondary); font-size: 23rpx; }.weather-chip__temp { color: var(--qd-ink); font-size: 38rpx; line-height: 1.1; font-weight: 650; }
.diagnosis-hero { position: relative; display: flex; min-height: 286rpx; margin-top: 30rpx; padding: 36rpx; box-sizing: border-box; overflow: hidden; color: #fff; background: var(--qd-primary); border-radius: 28rpx; }
.diagnosis-hero--pressed { background: var(--qd-primary-strong); }.diagnosis-hero__copy { position: relative; z-index: 2; max-width: 420rpx; }.diagnosis-hero__title { font-size: 48rpx; font-weight: 730; }.diagnosis-hero__subtitle { margin-top: 10rpx; color: rgba(255,255,255,.86); font-size: 27rpx; }.diagnosis-hero__cta { display: inline-flex; align-items: center; gap: 12rpx; min-height: 64rpx; margin-top: 30rpx; padding: 0 22rpx; color: var(--qd-primary-strong); background: #fff; border-radius: 999rpx; font-size: 26rpx; font-weight: 700; }
.camera-mark { position: absolute; right: 30rpx; bottom: -20rpx; width: 190rpx; height: 170rpx; border: 5rpx solid rgba(255,255,255,.68); border-radius: 32rpx; transform: rotate(-5deg); }.camera-mark::before { content: ''; position: absolute; width: 66rpx; height: 22rpx; left: 26rpx; top: -25rpx; border: 5rpx solid rgba(255,255,255,.68); border-bottom: 0; border-radius: 12rpx 12rpx 0 0; }.camera-mark__lens { position: absolute; width: 72rpx; height: 72rpx; left: 54rpx; top: 40rpx; border: 5rpx solid #fff; border-radius: 50%; }.camera-mark__leaf { position: absolute; width: 36rpx; height: 58rpx; left: 73rpx; top: 48rpx; border: 4rpx solid #fff; border-radius: 38rpx 6rpx 38rpx 6rpx; transform: rotate(20deg); }
.farm-strip { display: flex; align-items: center; gap: 18rpx; min-height: 104rpx; margin-top: 22rpx; padding: 16rpx 20rpx; box-sizing: border-box; background: #fff; border: 1rpx solid var(--qd-border); border-radius: 18rpx; }.farm-strip__mark { width: 46rpx; height: 46rpx; border: 3rpx solid var(--qd-primary); border-radius: 50% 6rpx 50% 6rpx; transform: rotate(-12deg); }.farm-strip__body { flex: 1; min-width: 0; }.farm-strip__name { font-size: 28rpx; font-weight: 650; }.farm-strip__arrow, .knowledge-row__arrow { color: var(--qd-primary); font-size: 48rpx; font-weight: 300; }
.task-list { overflow: hidden; }.task-row { display: flex; align-items: center; gap: 20rpx; min-height: 110rpx; padding: 14rpx 22rpx; box-sizing: border-box; }.task-row + .task-row { border-top: 1rpx solid var(--qd-border); }.task-row__check { width: 38rpx; height: 38rpx; box-sizing: border-box; border: 3rpx solid var(--qd-primary); border-radius: 50%; }.task-row__body { flex: 1; }.task-row__title { font-size: 29rpx; font-weight: 600; }
.recent-diagnosis { display: flex; gap: 20rpx; padding: 20rpx; }.recent-diagnosis__photo { position: relative; flex: none; width: 126rpx; height: 126rpx; overflow: hidden; background: #dbe9df; border-radius: 16rpx; }.leaf-shape { position: absolute; width: 64rpx; height: 94rpx; left: 32rpx; top: 18rpx; background: #4e8a62; border-radius: 70rpx 8rpx 70rpx 8rpx; transform: rotate(18deg); }.leaf-shape::after { content: ''; position: absolute; width: 22rpx; height: 22rpx; right: 13rpx; top: 24rpx; border-radius: 50%; background: #9c5a36; }.recent-diagnosis__body { flex: 1; min-width: 0; }.recent-diagnosis__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }.recent-diagnosis__title { font-size: 29rpx; font-weight: 650; }.recent-diagnosis__action { margin-top: 12rpx; color: var(--qd-primary-strong); font-size: 25rpx; font-weight: 600; }
.knowledge-row { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; background: var(--qd-primary-soft); border-radius: 20rpx; }.knowledge-row > view:first-child { flex: 1; }.knowledge-row__label { color: var(--qd-primary); font-size: 24rpx; font-weight: 650; }.knowledge-row__title { margin: 8rpx 0; font-size: 30rpx; line-height: 1.5; font-weight: 650; }
