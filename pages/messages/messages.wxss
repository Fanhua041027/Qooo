.message-preferences { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 24rpx; }
.message-preferences > view { flex: 1; }
.message-preferences__title { margin-bottom: 4rpx; font-size: 29rpx; font-weight: 650; }
.message-head { display: flex; align-items: center; justify-content: space-between; margin: 34rpx 0 18rpx; }
.message-head__action { min-height: 56rpx; color: var(--qd-primary); font-size: 25rpx; line-height: 56rpx; font-weight: 650; }
.message-list { display: flex; flex-direction: column; gap: 16rpx; }
.message-item { display: flex; align-items: flex-start; gap: 18rpx; padding: 22rpx; }
.message-item--read { background: var(--qd-surface-subtle); }
.message-item__mark { position: relative; flex: none; width: 58rpx; height: 58rpx; background: var(--qd-primary-soft); border-radius: 16rpx; }
.message-item__mark::before, .message-item__mark::after { content: ''; position: absolute; background: var(--qd-primary); }
.message-item__mark::before { width: 26rpx; height: 20rpx; left: 16rpx; top: 18rpx; border-radius: 4rpx; }
.message-item__mark::after { width: 12rpx; height: 4rpx; left: 23rpx; top: 41rpx; border-radius: 4rpx; }
.message-item__mark--TASK { background: var(--qd-warning-soft); }.message-item__mark--TASK::before, .message-item__mark--TASK::after { background: var(--qd-warning); }
.message-item__dot { position: absolute; z-index: 2; top: -5rpx; right: -5rpx; width: 16rpx; height: 16rpx; background: var(--qd-danger); border: 4rpx solid #fff; border-radius: 50%; }
.message-item__body { flex: 1; min-width: 0; }
.message-item__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.message-item__title { font-size: 29rpx; font-weight: 680; }
.message-item__copy { margin: 6rpx 0 10rpx; color: var(--qd-ink-secondary); font-size: 26rpx; line-height: 1.55; }
.message-item__arrow { flex: none; align-self: center; color: var(--qd-primary); font-size: 44rpx; }
.message-empty { margin-top: 24rpx; }
