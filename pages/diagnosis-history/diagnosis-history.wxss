.history-offline { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 22rpx; padding: 18rpx 20rpx; color: #87302b; background: var(--qd-danger-soft); border-radius: 16rpx; font-size: 25rpx; }.history-offline view view { font-weight: 700; }.history-offline text { display: block; }.history-offline > view:last-child { min-height: 56rpx; line-height: 56rpx; font-weight: 700; }
.filter-row { display: flex; gap: 14rpx; margin-bottom: 24rpx; overflow-x: auto; }.filter-chip { min-width: 110rpx; min-height: 64rpx; padding: 0 20rpx; box-sizing: border-box; color: var(--qd-ink-secondary); background: #fff; border: 1rpx solid var(--qd-border); border-radius: 999rpx; font-size: 26rpx; line-height: 64rpx; text-align: center; }.filter-chip--active { color: #fff; background: var(--qd-primary); border-color: var(--qd-primary); font-weight: 650; }.history-list { display: flex; flex-direction: column; gap: 18rpx; }.history-card { display: flex; gap: 20rpx; padding: 20rpx; }.history-card__photo { position: relative; flex: none; width: 132rpx; height: 152rpx; overflow: hidden; background: #c5d9c8; border-radius: 16rpx; }.history-leaf { position: absolute; width: 70rpx; height: 105rpx; left: 31rpx; top: 20rpx; background: #54825f; border-radius: 65rpx 6rpx 65rpx 6rpx; transform: rotate(14deg); }.history-leaf::after { content: ''; position: absolute; width: 21rpx; height: 18rpx; right: 12rpx; top: 34rpx; border-radius: 50%; background: #8c5a3e; }.history-card__body { flex: 1; min-width: 0; }.history-card__top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.history-card__crop { color: var(--qd-ink-secondary); font-size: 24rpx; }.history-card__result { margin: 5rpx 0; font-size: 31rpx; font-weight: 680; }.history-card__next { margin-top: 12rpx; color: var(--qd-primary-strong); font-size: 24rpx; font-weight: 600; }.empty-wrap { margin-top: 30rpx; }
.history-card__footer { display: flex; align-items: flex-end; justify-content: space-between; gap: 16rpx; margin-top: 12rpx; }
.history-card__footer .history-card__next { flex: 1; margin-top: 0; }
.history-card__delete { flex: none; min-width: 72rpx; min-height: 48rpx; color: var(--qd-ink-secondary); font-size: 23rpx; line-height: 48rpx; text-align: center; }
.history-card__photo image { width: 100%; height: 100%; }
.history-card__photo-note { position: absolute; right: 0; bottom: 0; left: 0; padding: 6rpx 4rpx; color: #fff; background: rgba(23,43,46,.78); font-size: 20rpx; text-align: center; }
