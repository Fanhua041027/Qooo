.diagnosis-page { padding-bottom: calc(164rpx + env(safe-area-inset-bottom)); }.diagnosis-page .fixed-cta { bottom: calc(106rpx + env(safe-area-inset-bottom)); padding-bottom: 18rpx; }
.step-line { display: flex; gap: 10rpx; height: 8rpx; }.step-line view { flex: 1; border-radius: 8rpx; background: #d8e2e3; }.step-line .step-line__active { background: var(--qd-primary); }
.page-title { margin-top: 32rpx; font-size: 42rpx; font-weight: 720; }.page-subtitle { margin-top: 12rpx; color: var(--qd-ink-secondary); font-size: 28rpx; line-height: 1.65; }
.state-banner { position: relative; margin-top: 24rpx; padding: 22rpx; border-radius: 16rpx; font-size: 26rpx; line-height: 1.6; }.state-banner--danger { color: #87302b; background: var(--qd-danger-soft); }.state-banner--warning { color: #74440f; background: var(--qd-warning-soft); }.state-banner__title { font-weight: 700; }.state-banner__link { margin-top: 8rpx; color: var(--qd-primary); font-weight: 700; }
.uploader { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 430rpx; margin-top: 28rpx; padding: 36rpx; box-sizing: border-box; background: #fff; border: 2rpx dashed #8caaad; border-radius: 24rpx; }.uploader--pressed { background: var(--qd-primary-soft); }.uploader__camera { position: relative; width: 88rpx; height: 68rpx; border: 5rpx solid var(--qd-primary); border-radius: 18rpx; }.uploader__camera::before { content: ''; position: absolute; width: 30rpx; height: 14rpx; left: 24rpx; top: -17rpx; border: 5rpx solid var(--qd-primary); border-bottom: 0; border-radius: 8rpx 8rpx 0 0; }.uploader__camera view { position: absolute; width: 28rpx; height: 28rpx; left: 25rpx; top: 15rpx; border: 5rpx solid var(--qd-primary); border-radius: 50%; }.uploader__title { margin-top: 26rpx; font-size: 32rpx; font-weight: 680; }.uploader__hint { margin-top: 8rpx; color: var(--qd-ink-secondary); font-size: 24rpx; text-align: center; }.uploader__mock { min-height: 64rpx; margin-top: 22rpx; padding: 0 20rpx; color: var(--qd-primary); font-size: 25rpx; line-height: 64rpx; }
.photo-preview { position: relative; height: 430rpx; margin-top: 28rpx; overflow: hidden; background: #d9e8df; border-radius: 24rpx; }.photo-preview image, .mock-photo { width: 100%; height: 100%; }.photo-preview--problem { border: 3rpx solid var(--qd-warning); }.mock-photo { position: relative; background: #b7d2bd; }.mock-photo__leaf { position: absolute; width: 270rpx; height: 340rpx; left: 190rpx; top: 42rpx; background: #4a8358; border-radius: 260rpx 22rpx 260rpx 22rpx; transform: rotate(16deg); }.mock-photo__leaf::after { content: ''; position: absolute; width: 5rpx; height: 300rpx; left: 120rpx; top: 22rpx; background: #d0e4c4; transform: rotate(34deg); }.mock-photo__spot { position: absolute; border-radius: 50%; background: #765238; opacity: .9; }.mock-photo__spot--1 { width: 56rpx; height: 45rpx; left: 320rpx; top: 148rpx; }.mock-photo__spot--2 { width: 36rpx; height: 31rpx; left: 270rpx; top: 238rpx; }.photo-preview__tools { position: absolute; right: 16rpx; bottom: 16rpx; display: flex; gap: 12rpx; }.photo-preview__tools view { min-height: 62rpx; padding: 0 20rpx; color: #fff; background: rgba(23,43,46,.82); border-radius: 999rpx; font-size: 24rpx; line-height: 62rpx; }.photo-preview__loading { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; color: #fff; background: rgba(23,43,46,.72); }.upload-ring { width: 70rpx; height: 70rpx; border: 6rpx solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: spin .9s linear infinite; } @keyframes spin { to { transform: rotate(360deg); } }
.quality-result { display: flex; gap: 18rpx; margin-top: 18rpx; padding: 22rpx; border-radius: 16rpx; font-size: 26rpx; line-height: 1.6; }.quality-result--warning { color: #74440f; background: var(--qd-warning-soft); }.quality-result--danger { color: #87302b; background: var(--qd-danger-soft); }.quality-result--success { color: #22633f; background: var(--qd-success-soft); }.quality-result__icon { display: flex; align-items: center; justify-content: center; flex: none; width: 42rpx; height: 42rpx; border: 3rpx solid currentColor; border-radius: 50%; font-weight: 800; }.quality-result__title { font-weight: 700; }.quality-result__actions { display: flex; gap: 34rpx; margin-top: 10rpx; font-weight: 700; }
.context-form { margin-top: 26rpx; padding: 0 22rpx; }.context-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 112rpx; }.context-row__label { font-weight: 650; }.context-row__value { color: var(--qd-primary-strong); font-weight: 600; }.context-row__value text { margin-left: 10rpx; font-size: 38rpx; font-weight: 300; }
.guide-grid { display: flex; gap: 16rpx; margin-top: 20rpx; }.guide-grid > view { flex: 1; text-align: center; color: var(--qd-ink-secondary); font-size: 24rpx; }.guide-visual { position: relative; height: 106rpx; margin-bottom: 12rpx; background: #e8eeee; border-radius: 14rpx; }.guide-visual::before { content: ''; position: absolute; width: 46rpx; height: 64rpx; left: 50%; top: 20rpx; margin-left: -23rpx; background: var(--qd-primary); border-radius: 48rpx 5rpx 48rpx 5rpx; }.guide-visual--near::after { content: ''; position: absolute; width: 60rpx; height: 60rpx; left: 50%; top: 18rpx; margin-left: -30rpx; border: 3rpx solid var(--qd-accent); border-radius: 50%; }.guide-visual--light::after { content: ''; position: absolute; width: 22rpx; height: 22rpx; right: 18rpx; top: 16rpx; background: var(--qd-accent); border-radius: 50%; }
