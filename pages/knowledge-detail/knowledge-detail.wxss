page { background: #fff; }.article { max-width: 720rpx; margin: 0 auto; padding: 30rpx 36rpx calc(70rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }.article__meta { display: flex; align-items: center; gap: 16rpx; color: var(--qd-ink-secondary); font-size: 24rpx; }.article__title { margin-top: 26rpx; font-size: 48rpx; line-height: 1.32; letter-spacing: -1rpx; font-weight: 740; }.article__lead { margin-top: 24rpx; color: var(--qd-ink-secondary); font-size: 31rpx; line-height: 1.8; }.article-tools { display: flex; gap: 24rpx; margin-top: 22rpx; color: var(--qd-primary); font-size: 25rpx; }.article-tools view { min-height: 60rpx; line-height: 60rpx; }.article-visual { position: relative; height: 330rpx; margin: 32rpx -36rpx 0; overflow: hidden; background: #d5e5d9; }.article-visual__leaf { position: absolute; width: 220rpx; height: 270rpx; left: 265rpx; top: 24rpx; background: #4f825a; border-radius: 210rpx 18rpx 210rpx 18rpx; transform: rotate(14deg); }.article-visual__spot { position: absolute; width: 72rpx; height: 54rpx; left: 390rpx; top: 110rpx; border-radius: 50%; background: #82543c; }.article-visual__caption { position: absolute; right: 20rpx; bottom: 18rpx; left: 20rpx; padding: 14rpx 18rpx; color: #fff; background: rgba(23,43,46,.80); border-radius: 12rpx; font-size: 24rpx; }.article-section { margin-top: 48rpx; }.article-section__title { margin-bottom: 16rpx; font-size: 36rpx; font-weight: 700; }.article__paragraph { margin-top: 16rpx; color: #304a4d; font-size: 30rpx; line-height: 1.9; }.compare-table { margin-top: 34rpx; overflow: hidden; border: 1rpx solid var(--qd-border); border-radius: 16rpx; }.compare-table__row { display: grid; grid-template-columns: .8fr 1fr 1fr; }.compare-table__row + .compare-table__row { border-top: 1rpx solid var(--qd-border); }.compare-table__row view { padding: 18rpx 12rpx; color: #304a4d; font-size: 24rpx; line-height: 1.45; }.compare-table__row view + view { border-left: 1rpx solid var(--qd-border); }.compare-table__head { background: var(--qd-primary-soft); font-weight: 700; }.article-callout { margin-top: 40rpx; padding: 26rpx; color: var(--qd-primary-strong); background: var(--qd-primary-soft); border-radius: 18rpx; font-size: 28rpx; line-height: 1.9; }.article-callout__title { margin-bottom: 8rpx; font-size: 31rpx; font-weight: 700; }.article-source { display: grid; grid-template-columns: 140rpx 1fr; gap: 10rpx 20rpx; margin-top: 48rpx; padding-top: 28rpx; border-top: 1rpx solid var(--qd-border); color: var(--qd-ink-secondary); font-size: 24rpx; }.article-source view { font-weight: 650; }.article-action { margin-top: 42rpx; }.knowledge-page--large .article__paragraph { font-size: 36rpx; line-height: 1.9; }.knowledge-page--large .article__lead { font-size: 35rpx; }.knowledge-page--large .article-section__title { font-size: 40rpx; }
