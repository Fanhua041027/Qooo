.processing-page { min-height: 100vh; background: #f6f8f8; }.processing-content { padding: 56rpx 40rpx calc(60rpx + env(safe-area-inset-bottom)); text-align: center; }.analysis-visual { position: relative; width: 290rpx; height: 290rpx; margin: 0 auto; }.analysis-visual__photo { position: absolute; z-index: 2; width: 200rpx; height: 230rpx; left: 45rpx; top: 28rpx; overflow: hidden; background: #c2d8c8; border-radius: 24rpx; }.analysis-visual__leaf { position: absolute; width: 112rpx; height: 154rpx; left: 44rpx; top: 34rpx; background: #4b8159; border-radius: 100rpx 8rpx 100rpx 8rpx; transform: rotate(13deg); }.analysis-visual__leaf::after { content: ''; position: absolute; width: 28rpx; height: 22rpx; right: 26rpx; top: 46rpx; border-radius: 50%; background: #85583d; }.analysis-visual__orbit { position: absolute; inset: 0; border: 3rpx solid #aac1c3; border-top-color: var(--qd-accent); border-radius: 50%; animation: orbit 1.8s linear infinite; }.scan-line { position: absolute; z-index: 3; right: 16rpx; left: 16rpx; height: 3rpx; top: 18rpx; background: var(--qd-accent); box-shadow: 0 0 10rpx rgba(182,94,24,.35); animation: scan 1.5s ease-in-out infinite alternate; }@keyframes orbit { to { transform: rotate(360deg); } }@keyframes scan { to { transform: translateY(190rpx); } }
.processing-title { margin-top: 34rpx; font-size: 40rpx; font-weight: 720; }.processing-subtitle { max-width: 600rpx; margin: 14rpx auto 0; color: var(--qd-ink-secondary); font-size: 28rpx; line-height: 1.65; }.stage-list { margin-top: 44rpx; padding: 8rpx 24rpx; text-align: left; }.stage-row { display: flex; align-items: center; gap: 22rpx; min-height: 112rpx; color: #738588; }.stage-row + .stage-row { border-top: 1rpx solid var(--qd-border); }.stage-row__mark { display: flex; align-items: center; justify-content: center; flex: none; width: 44rpx; height: 44rpx; box-sizing: border-box; border: 3rpx solid #a9b9bb; border-radius: 50%; font-size: 23rpx; font-weight: 700; }.stage-row view view { font-size: 29rpx; font-weight: 650; }.stage-row text { font-size: 24rpx; }.stage-row--done { color: var(--qd-primary-strong); }.stage-row--done .stage-row__mark { color: #fff; background: var(--qd-primary); border-color: var(--qd-primary); }.processing-note { margin-top: 28rpx; color: #566b6e; font-size: 24rpx; line-height: 1.65; }
.processing-state { padding: 90rpx 32rpx; }.secondary-link { min-height: 72rpx; color: var(--qd-primary); font-size: 27rpx; line-height: 72rpx; text-align: center; }
@media (prefers-reduced-motion: reduce) { .analysis-visual__orbit, .scan-line { animation: none; } .scan-line { top: 105rpx; } }
