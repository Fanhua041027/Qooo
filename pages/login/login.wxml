<view class="login-page">
  <view class="brand" aria-label="农间诊">
    <view class="brand__mark" aria-hidden="true"><view class="brand__leaf"></view><view class="brand__pulse"></view></view>
    <text>农间诊</text>
  </view>

  <view class="login-copy">
    <view class="login-copy__title">看清作物问题，<text class="login-copy__line">马上知道下一步。</text></view>
    <view class="login-copy__body">拍摄叶片、果实或茎秆异常，获得清晰的初步判断和可执行建议。</view>
  </view>

  <view class="field-scene" aria-hidden="true">
    <view class="field-scene__sun"></view>
    <view class="field-scene__row field-scene__row--1"></view>
    <view class="field-scene__row field-scene__row--2"></view>
    <view class="field-scene__row field-scene__row--3"></view>
  </view>

  <view class="login-actions">
    <qd-button label="微信一键进入" loading="{{loading}}" bind:tap="mockLogin" />
    <view class="privacy-copy">进入即表示你已阅读并同意 <text bindtap="showPrivacy">《用户协议与隐私说明》</text></view>
    <view class="dev-entry" bindtap="showDenied">查看权限拒绝状态</view>
  </view>

  <view wx:if="{{privacyDenied}}" class="permission-panel" aria-role="alert">
    <view class="permission-panel__grab"></view>
    <view class="permission-panel__title">需要你的授权</view>
    <view class="permission-panel__text">你拒绝了隐私授权，因此无法保存诊断记录。可以继续浏览公开知识，或重新授权后使用完整功能。</view>
    <view class="permission-panel__actions">
      <qd-button label="暂不授权" type="ghost" size="medium" bind:tap="dismissDenied" />
      <qd-button label="重新授权" size="medium" bind:tap="dismissDenied" />
    </view>
  </view>
</view>
