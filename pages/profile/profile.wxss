.profile-head { display: flex; align-items: center; gap: 20rpx; padding: 10rpx 2rpx 18rpx; }.avatar { display: flex; align-items: center; justify-content: center; flex: none; width: 104rpx; height: 104rpx; color: #fff; background: var(--qd-primary); border-radius: 50%; font-size: 39rpx; font-weight: 700; }.profile-head__copy { flex: 1; }.profile-head__name { font-size: 38rpx; font-weight: 720; }.profile-head__meta { margin-top: 5rpx; color: var(--qd-ink-secondary); font-size: 25rpx; }.profile-head__edit { min-height: 64rpx; padding: 0 18rpx; color: var(--qd-primary); border: 1rpx solid #9eb8ba; border-radius: 999rpx; line-height: 64rpx; font-size: 24rpx; }.profile-stats { display: flex; margin-top: 20rpx; padding: 22rpx 0; }.profile-stats > view { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }.profile-stats > view + view { border-left: 1rpx solid var(--qd-border); }.profile-stats text:first-child { font-size: 36rpx; font-weight: 720; }.profile-stats text:last-child { color: var(--qd-ink-secondary); font-size: 23rpx; }.menu-group { overflow: hidden; }.menu-row { display: flex; align-items: center; gap: 20rpx; min-height: 104rpx; padding: 0 22rpx; box-sizing: border-box; }.menu-row + .menu-row { border-top: 1rpx solid var(--qd-border); }.menu-row > text { flex: 1; font-size: 29rpx; font-weight: 580; }.menu-row > view:last-child { display: flex; align-items: center; gap: 8rpx; color: var(--qd-ink-secondary); font-size: 38rpx; font-weight: 300; }.menu-row__icon { position: relative; width: 42rpx; height: 42rpx; box-sizing: border-box; color: var(--qd-primary); border: 3rpx solid currentColor; border-radius: 9rpx; }.menu-row__icon--farm { border-radius: 50% 5rpx 50% 5rpx; transform: rotate(-10deg); }.menu-row__icon--task::after { content: ''; position: absolute; width: 16rpx; height: 8rpx; left: 9rpx; top: 10rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(-45deg); }.menu-row__icon--notice { border-radius: 22rpx 22rpx 8rpx 8rpx; }.menu-row__icon--help { border-radius: 50%; }.menu-row__icon--help::after { content: '?'; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 25rpx; font-weight: 700; }.menu-row__icon--lab::after { content: ''; position: absolute; width: 18rpx; height: 22rpx; left: 9rpx; top: 8rpx; border: 3rpx solid currentColor; border-top: 0; transform: skew(-8deg); }.profile-note { color: var(--qd-ink-secondary); font-size: 24rpx; line-height: 1.65; }.logout { min-height: 88rpx; margin-top: 36rpx; color: var(--qd-danger); background: #fff; border: 1rpx solid #e6c3c0; border-radius: 18rpx; line-height: 88rpx; text-align: center; font-size: 28rpx; font-weight: 650; }.version { margin-top: 22rpx; color: #718587; font-size: 22rpx; text-align: center; }
