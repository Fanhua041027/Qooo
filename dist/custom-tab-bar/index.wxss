.custom-tab-bar{background:hsla(0,0%,100%,.98);border-top:1rpx solid var(--qd-border);bottom:0;box-shadow:0 -4rpx 18rpx rgba(23,43,46,.06);box-sizing:border-box;display:flex;height:calc(112rpx + env(safe-area-inset-bottom));left:0;padding:12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));position:fixed;right:0;z-index:var(--qd-z-sticky,20)}.custom-tab-bar__item{align-items:center;border-radius:16rpx;color:var(--qd-muted-foreground);display:flex;flex:1;flex-direction:column;font-size:23rpx;gap:7rpx;justify-content:center;line-height:1.2;min-height:88rpx;min-width:0;transition:color .16s ease-out,background-color .16s ease-out}.custom-tab-bar__item--active{background:var(--qd-primary-soft);color:var(--qd-primary-strong);font-weight:700}.custom-tab-bar__item:active{background:var(--qd-surface-subtle)}.custom-tab-bar__icon{border:3rpx solid;box-sizing:border-box;height:32rpx;position:relative;width:32rpx}.custom-tab-bar__icon--home{border-radius:6rpx 6rpx 3rpx 3rpx;border-top:0;height:25rpx;margin-top:7rpx}.custom-tab-bar__icon--home::before{border-left:3rpx solid;border-top:3rpx solid;content:"";height:20rpx;left:3rpx;position:absolute;top:-11rpx;transform:rotate(45deg);width:20rpx}.custom-tab-bar__icon--diagnosis{border-radius:50%}.custom-tab-bar__icon--diagnosis::after{background:currentColor;border-radius:50%;content:"";height:12rpx;left:7rpx;position:absolute;top:7rpx;width:12rpx}.custom-tab-bar__icon--farm{border-radius:50% 5rpx 50% 5rpx;transform:rotate(-12deg)}.custom-tab-bar__icon--farm::after{background:currentColor;content:"";height:25rpx;left:13rpx;position:absolute;top:6rpx;transform:rotate(35deg);width:3rpx}.custom-tab-bar__icon--tasks{border-radius:5rpx}.custom-tab-bar__icon--tasks::after{border-bottom:3rpx solid;border-left:3rpx solid;content:"";height:7rpx;left:6rpx;position:absolute;top:7rpx;transform:rotate(-45deg);width:14rpx}.custom-tab-bar__icon--profile{border-radius:50%;height:20rpx;margin-bottom:13rpx;width:20rpx}.custom-tab-bar__icon--profile::after{border:3rpx solid;border-bottom:0;border-radius:22rpx 22rpx 0 0;content:"";height:16rpx;left:-9rpx;position:absolute;top:21rpx;width:32rpx}@media screen and (max-width:380px){.custom-tab-bar{padding-left:12rpx;padding-right:12rpx}.custom-tab-bar__item{font-size:22rpx;min-height:84rpx}}@media (prefers-reduced-motion:reduce){.custom-tab-bar__item{transition:none}}