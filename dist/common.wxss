.task-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--qd-border);
}

.task-item:last-child {
  border-bottom: 0;
}

.task-item--completed {
  opacity: 0.68;
}

.task-item__body {
  min-width: 0;
  flex: 1;
}

.task-item__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.task-item__title {
  flex: 1;
  font-size: 31rpx;
  font-weight: 650;
}

.task-item__description {
  display: block;
  margin-top: 8rpx;
  color: var(--qd-muted-foreground);
  font-size: 27rpx;
}

.task-item__meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
}

.task-item__time {
  display: block;
  color: var(--qd-muted-foreground);
  font-size: 24rpx;
}

.task-item__priority {
  flex: none;
  font-size: 23rpx;
  font-weight: 650;
}

.task-item__priority--high {
  color: var(--qd-warning);
}

.task-item__priority--medium {
  color: var(--qd-primary);
}

.task-item__priority--low {
  color: var(--qd-muted-foreground);
}

.task-item .qd-button {
  min-width: 132rpx;
  padding: 0 22rpx;
}

.task-item__actions {
  display: flex;
  flex: 0 0 auto;
  gap: 8rpx;
}

.task-item__actions .qd-button {
  min-width: 108rpx;
  padding: 0 14rpx;
  font-size: 25rpx;
}

.task-item__note {
  width: 100%;
  margin-top: 20rpx;
}

.task-item__note-input {
  width: 100%;
  min-height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--qd-border);
  border-radius: 12rpx;
  background: var(--qd-surface-subtle);
  color: var(--qd-foreground);
  font-size: 27rpx;
}

.task-item__note-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 12rpx;
}

.task-item__note-actions .qd-button {
  min-width: 112rpx;
  min-height: 72rpx;
  font-size: 25rpx;
}

.task-item__edit {
  width: 100%;
  margin-top: 20rpx;
}

.task-item__edit-input, .task-item__edit-textarea {
  width: 100%;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--qd-border);
  border-radius: 12rpx;
  background: var(--qd-surface-subtle);
  color: var(--qd-foreground);
  font-size: 27rpx;
}

.task-item__edit-input {
  min-height: 80rpx;
}

.task-item__edit-textarea {
  min-height: 116rpx;
  margin-top: 12rpx;
}

.task-item__edit-date {
  margin-top: 14rpx;
  color: var(--qd-muted-foreground);
  font-size: 24rpx;
}

.task-item__edit-date picker view {
  min-height: 72rpx;
  margin-top: 8rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--qd-border);
  border-radius: 12rpx;
  background: var(--qd-surface-subtle);
  color: var(--qd-foreground);
  font-size: 26rpx;
}

@media screen and (max-width: 380px) {
  .task-item {
    align-items: flex-start;
    gap: 14rpx;
  }
  .task-item .qd-button {
    min-width: 112rpx;
    padding: 0 16rpx;
    font-size: 25rpx;
  }
}
