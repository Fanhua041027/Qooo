:root,
page {
  --qd-primary: #25666d;
  --qd-primary-strong: #174b51;
  --qd-primary-soft: #e7f1f2;
  --qd-accent: #b65e18;
  --qd-accent-soft: #fff0e3;
  --qd-background: #f6f8f8;
  --qd-surface: #ffffff;
  --qd-surface-muted: #eef3f3;
  --qd-surface-subtle: #f7fafa;
  --qd-foreground: #172b2e;
  --qd-muted-foreground: #465f62;
  --qd-ink-secondary: #465f62;
  --qd-border: #d4e0e1;
  --qd-success: #277a4c;
  --qd-warning: #9b5b12;
  --qd-warning-soft: #fff0d9;
  --qd-danger: #b63f37;
  --qd-info: #246aa5;
  --qd-radius-sm: 8rpx;
  --qd-radius-md: 16rpx;
  --qd-radius-lg: 24rpx;
  --qd-space-1: 8rpx;
  --qd-space-2: 16rpx;
  --qd-space-3: 24rpx;
  --qd-space-4: 32rpx;
  --qd-space-5: 40rpx;
  --qd-space-6: 48rpx;
  --qd-page-gutter: 32rpx;
}

page {
  min-height: 100%;
  background: var(--qd-background);
  color: var(--qd-foreground);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

view,
text,
button,
input,
textarea,
scroll-view,
image {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page--with-footer {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.page-title {
  display: block;
  margin: 8rpx 0 12rpx;
  color: var(--qd-foreground);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.page-description {
  display: block;
  max-width: 620rpx;
  color: var(--qd-muted-foreground);
  font-size: 28rpx;
}

.section {
  margin-top: 48rpx;
}

.section-title {
  color: var(--qd-foreground);
  font-size: 34rpx;
  font-weight: 650;
}

.surface {
  background: var(--qd-surface);
  border-radius: var(--qd-radius-lg);
}

.divider {
  height: 1rpx;
  background: var(--qd-border);
}

.fixed-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid var(--qd-border);
}

@media (prefers-reduced-motion: reduce) {
  view,
  text,
  button,
  input,
  textarea,
  scroll-view,
  image {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}
