:root,page{--qd-primary:#25666d;--qd-primary-strong:#174b51;--qd-primary-soft:#e7f1f2;--qd-accent:#b65e18;--qd-accent-soft:#fff0e3;--qd-background:#f6f8f8;--qd-surface:#fff;--qd-surface-muted:#eef3f3;--qd-surface-subtle:#f7fafa;--qd-foreground:#172b2e;--qd-muted-foreground:#465f62;--qd-ink-secondary:#465f62;--qd-border:#d4e0e1;--qd-success:#277a4c;--qd-success-soft:#e4f5eb;--qd-warning:#9b5b12;--qd-warning-soft:#fff0d9;--qd-danger:#b63f37;--qd-danger-soft:#fbe9eb;--qd-info:#246aa5;--qd-info-soft:#e7f1fb;--qd-focus:#4d9ca2;--qd-overlay:rgba(23,43,46,.44);--qd-z-sticky:20;--qd-z-modal:40;--qd-z-toast:60;--qd-radius-sm:8rpx;--qd-radius-md:16rpx;--qd-radius-lg:24rpx;--qd-space-1:8rpx;--qd-space-2:16rpx;--qd-space-3:24rpx;--qd-space-4:32rpx;--qd-space-5:40rpx;--qd-space-6:48rpx;--qd-page-gutter:32rpx}page{background:var(--qd-background);color:var(--qd-foreground);font-family:-apple-system,BlinkMacSystemFont,PingFang SC,Microsoft YaHei,sans-serif;font-size:30rpx;line-height:1.5;min-height:100%;-webkit-font-smoothing:antialiased}button,image,input,scroll-view,text,textarea,view{box-sizing:border-box}button::after{border:0}.page{min-height:100vh;overflow-x:hidden;padding:32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom))}.page--with-footer{padding-bottom:calc(180rpx + env(safe-area-inset-bottom))}.page-title{color:var(--qd-foreground);display:block;font-size:48rpx;font-weight:700;letter-spacing:-.5rpx;line-height:1.2;margin:8rpx 0 12rpx;overflow-wrap:anywhere}.page-description{color:var(--qd-muted-foreground);display:block;font-size:28rpx;line-height:1.65;max-width:620rpx;overflow-wrap:anywhere}.section{margin-top:48rpx}.section-title{color:var(--qd-foreground);font-size:34rpx;font-weight:650}.surface{background:var(--qd-surface);border:1rpx solid var(--qd-border);border-radius:var(--qd-radius-lg)}.divider{background:var(--qd-border);height:1rpx}.fixed-footer{background:hsla(0,0%,100%,.98);border-top:1rpx solid var(--qd-border);bottom:0;left:0;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));position:fixed;right:0;z-index:var(--qd-z-sticky)}.farm-card__main:active,.home-context__item:active,.profile-menu > view:active,.surface:active{background:var(--qd-surface-subtle)}@media screen and (max-width:380px){.page{padding-left:24rpx;padding-right:24rpx}.page-title{font-size:44rpx}.page-description{font-size:27rpx}.section{margin-top:40rpx}}@media (prefers-reduced-motion:reduce){button,image,input,scroll-view,text,textarea,view{animation-duration:.01ms!important;transition-duration:.01ms!important}}