.shop-page{padding-bottom:120rpx}.shop-heading{align-items:flex-start;display:flex;gap:18rpx;justify-content:space-between}.shop-heading > view:first-child{flex:1;min-width:0}.shop-cart-button{align-items:center;background:var(--qd-surface);border:1rpx solid var(--qd-border);border-radius:999rpx;color:var(--qd-primary-strong);display:flex;font-size:25rpx;font-weight:700;gap:8rpx;min-height:72rpx;padding:0 18rpx}.shop-cart-button:active,.shop-category:active{background:var(--qd-surface-subtle)}.shop-message{background:var(--qd-success-soft);border-radius:var(--qd-radius-md);color:#166534;display:flex;font-size:25rpx;gap:16rpx;justify-content:space-between;line-height:1.5;margin-top:20rpx;padding:18rpx 20rpx}.shop-message text:last-child{flex:none;font-weight:700}.shop-categories{display:flex;gap:12rpx;margin-top:28rpx;overflow-x:auto;padding-bottom:4rpx}.shop-category{align-items:center;background:var(--qd-surface);border:1rpx solid var(--qd-border);border-radius:999rpx;color:var(--qd-muted-foreground);display:inline-flex;flex:none;font-size:24rpx;min-height:72rpx;padding:0 20rpx;white-space:nowrap}.shop-category--active{background:var(--qd-primary);border-color:var(--qd-primary);color:#fff;font-weight:700}.shop-grid{display:grid;gap:16rpx;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:24rpx}.shop-product{min-width:0;overflow:hidden;padding:18rpx}.shop-product__visual{align-items:flex-start;background:var(--qd-primary-soft);border-radius:var(--qd-radius-md);color:var(--qd-primary-strong);display:flex;justify-content:space-between;min-height:136rpx;padding:20rpx}.shop-product__visual > text{display:block;font-size:36rpx;font-weight:700;margin-top:26rpx}.shop-product__name,.shop-product__safety,.shop-product__subtitle{display:block}.shop-product__name{font-size:29rpx;font-weight:700;line-height:1.4;margin-top:16rpx;overflow-wrap:anywhere}.shop-product__subtitle{color:var(--qd-muted-foreground);font-size:23rpx;line-height:1.55;margin-top:6rpx;min-height:72rpx}.shop-product__safety{color:var(--qd-success);font-size:21rpx;line-height:1.45;margin-top:8rpx;min-height:58rpx}.shop-product__bottom{align-items:flex-end;display:flex;gap:10rpx;justify-content:space-between;margin-top:14rpx}.shop-product__price{color:var(--qd-accent);font-size:33rpx;font-weight:700}.shop-product__unit{color:var(--qd-muted-foreground);display:block;font-size:20rpx;line-height:1.4}.shop-product__bottom .qd-button{min-width:156rpx;padding:0 12rpx}.shop-overlay{align-items:flex-end;background:var(--qd-overlay);display:flex;inset:0;position:fixed;z-index:var(--qd-z-modal)}.shop-sheet{background:var(--qd-surface);border-radius:24rpx 24rpx 0 0;max-height:86vh;overflow-y:auto;padding:28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));width:100%}.shop-sheet__title{display:block;font-size:36rpx;font-weight:700}.shop-cart-list{margin-top:18rpx}.shop-cart-item{align-items:center;border-bottom:1rpx solid var(--qd-border);display:flex;gap:18rpx;justify-content:space-between;padding:18rpx 0}.shop-cart-item > view:first-child{flex:1;min-width:0}.shop-cart-item text{display:block}.shop-cart-item > view:first-child text:first-child{font-size:27rpx;font-weight:700}.shop-cart-item > view:first-child text:last-child{color:var(--qd-accent);font-size:24rpx;margin-top:6rpx}.shop-quantity{align-items:center;display:flex;gap:20rpx}.shop-quantity text{align-items:center;border:1rpx solid var(--qd-border);border-radius:50%;display:inline-flex;font-size:29rpx;height:56rpx;justify-content:center;width:56rpx}.shop-quantity text:nth-child(2){border:0;width:auto}.shop-empty-cart{color:var(--qd-muted-foreground);display:block;line-height:1.6;margin:32rpx 0}.shop-address{background:var(--qd-surface-subtle);border:1rpx solid var(--qd-border);border-radius:var(--qd-radius-md);font-size:26rpx;margin-top:22rpx;min-height:78rpx;padding:18rpx 20rpx;width:100%}.shop-total{color:var(--qd-accent);display:block;font-size:32rpx;font-weight:700;margin:18rpx 0}.shop-sheet > .qd-button:last-child{margin-top:14rpx}@media screen and (max-width:380px){.shop-grid{grid-template-columns:1fr}.shop-product__visual{min-height:110rpx}}