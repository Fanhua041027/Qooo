.home-page {
  padding-top: 24rpx;
}

.home-offline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #fff1d7;
  color: #704000;
  font-size: 26rpx;
  line-height: 1.5;
}

.home-offline__action {
  flex: none;
  min-height: 88rpx;
  color: var(--qd-primary);
  font-weight: 700;
  line-height: 88rpx;
}

.home-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.home-heading > view:first-child {
  min-width: 0;
  flex: 1;
}

.home-heading__greeting {
  display: block;
  color: var(--qd-muted-foreground);
  font-size: 27rpx;
}

.home-heading__tools {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 18rpx;
}

.home-heading__status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--qd-muted-foreground);
  font-size: 24rpx;
  white-space: nowrap;
}

.home-heading__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--qd-success);
}

.home-heading__status--offline {
  color: var(--qd-warning);
}

.home-heading__status--offline .home-heading__dot {
  background: var(--qd-warning);
}

.home-heading__messages {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: 10rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--qd-border);
  border-radius: 999rpx;
  background: var(--qd-surface);
  color: var(--qd-primary-strong);
  font-size: 24rpx;
}

.home-heading__messages-badge {
  display: flex;
  min-width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  padding: 0 7rpx;
  border-radius: 999rpx;
  background: var(--qd-danger);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}

.home-login {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: var(--qd-surface);
}

.home-login__title {
  display: block;
  font-size: 29rpx;
  font-weight: 650;
}

.home-login__description {
  display: block;
  margin-top: 4rpx;
  color: var(--qd-muted-foreground);
  font-size: 24rpx;
}

.home-diagnosis {
  margin-top: 32rpx;
  padding: 36rpx;
  border-radius: 24rpx;
  background: var(--qd-primary-strong);
  color: #fff;
  box-shadow: 0 6rpx 12rpx rgba(23, 75, 81, 0.18);
}

.home-diagnosis__content {
  margin-bottom: 34rpx;
}

.home-diagnosis__eyebrow {
  display: block;
  color: #b9d6d4;
  font-size: 24rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.home-diagnosis__title {
  display: block;
  margin-top: 24rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.home-diagnosis__description {
  display: block;
  margin-top: 12rpx;
  color: #dceae2;
  font-size: 27rpx;
  line-height: 1.6;
}

.home-diagnosis .qd-button {
  background: #fff;
  color: var(--qd-primary-strong);
}

.home-context {
  display: flex;
  gap: 2rpx;
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: var(--qd-border);
}

.home-context__item {
  min-width: 0;
  flex: 1;
  padding: 28rpx;
  background: var(--qd-surface);
}

.home-context__label, .home-context__meta {
  display: block;
  color: var(--qd-muted-foreground);
  font-size: 24rpx;
}

.home-context__value {
  display: block;
  margin: 10rpx 0 6rpx;
  overflow: hidden;
  font-size: 31rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-context__meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-overview {
  margin-top: 28rpx;
  padding: 28rpx;
  border: 1rpx solid var(--qd-border);
  border-radius: 20rpx;
  background: var(--qd-surface);
}

.home-overview__heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.home-overview__heading .section-title {
  display: block;
  font-size: 31rpx;
}

.home-overview__sync {
  display: block;
  margin-top: 6rpx;
  color: var(--qd-muted-foreground);
  font-size: 24rpx;
}

.home-overview__link {
  min-height: 88rpx;
  color: var(--qd-primary);
  font-size: 26rpx;
  font-weight: 650;
  line-height: 88rpx;
}

.home-overview__stats {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.home-overview__stat {
  min-width: 0;
  flex: 1;
  padding: 18rpx 16rpx;
  border-radius: 14rpx;
  background: var(--qd-surface-subtle);
}

.home-overview__value {
  display: block;
  color: var(--qd-primary-strong);
  font-size: 36rpx;
  font-weight: 720;
  line-height: 1.1;
}

.home-overview__label {
  display: block;
  margin-top: 8rpx;
  color: var(--qd-muted-foreground);
  font-size: 24rpx;
}

.home-list {
  padding: 0 28rpx;
}

.home-list__empty {
  display: block;
  padding: 40rpx 0;
  color: var(--qd-muted-foreground);
  font-size: 27rpx;
}

@media screen and (max-width: 380px) {
  .home-heading {
    gap: 12rpx;
  }
  .home-heading__tools {
    gap: 8rpx;
  }
  .home-heading__status {
    font-size: 22rpx;
  }
  .home-heading__messages {
    padding: 0 14rpx;
  }
  .home-diagnosis {
    padding: 28rpx;
  }
  .home-diagnosis__title {
    font-size: 38rpx;
  }
  .home-context__item {
    padding: 22rpx 18rpx;
  }
}
