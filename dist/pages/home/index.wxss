.qd-section-header{align-items:center;display:flex;justify-content:space-between;margin-bottom:20rpx}.qd-section-header__title{color:var(--qd-foreground);font-size:34rpx;font-weight:650}.qd-section-header__action{align-items:center;color:var(--qd-primary);display:flex;font-size:27rpx;font-weight:600;min-height:88rpx;padding:0 0 0 20rpx}.home-page{padding-top:24rpx}.home-offline{align-items:center;background:#fff1d7;border-radius:12rpx;color:#704000;display:flex;font-size:26rpx;gap:18rpx;justify-content:space-between;line-height:1.5;margin-bottom:24rpx;padding:18rpx 22rpx}.home-offline__action{color:var(--qd-primary);flex:none;font-weight:700;line-height:88rpx;min-height:88rpx}.home-heading{align-items:flex-start;display:flex;gap:24rpx;justify-content:space-between}.home-heading > view:first-child{flex:1;min-width:0}.home-heading__greeting{color:var(--qd-muted-foreground);display:block;font-size:27rpx}.home-heading__tools{align-items:flex-end;display:flex;flex-direction:column;gap:18rpx}.home-heading__status{align-items:center;color:var(--qd-muted-foreground);display:flex;font-size:24rpx;gap:10rpx;white-space:nowrap}.home-heading__dot{background:var(--qd-success);border-radius:50%;height:14rpx;width:14rpx}.home-heading__status--offline{color:var(--qd-warning)}.home-heading__status--offline .home-heading__dot{background:var(--qd-warning)}.home-heading__messages{align-items:center;background:var(--qd-surface);border:1rpx solid var(--qd-border);border-radius:999rpx;color:var(--qd-primary-strong);display:flex;font-size:24rpx;gap:10rpx;min-height:88rpx;padding:0 18rpx}.home-heading__messages-badge{align-items:center;background:var(--qd-danger);border-radius:999rpx;color:#fff;display:flex;font-size:20rpx;font-weight:700;height:34rpx;justify-content:center;min-width:34rpx;padding:0 7rpx}.home-login{align-items:center;background:var(--qd-surface);border-radius:16rpx;display:flex;gap:20rpx;justify-content:space-between;margin-top:28rpx;padding:24rpx 28rpx}.home-login__title{display:block;font-size:29rpx;font-weight:650}.home-login__description{color:var(--qd-muted-foreground);display:block;font-size:24rpx;margin-top:4rpx}.home-diagnosis{background:var(--qd-primary-strong);border-radius:24rpx;box-shadow:0 6rpx 12rpx rgba(23,75,81,.18);color:#fff;margin-top:32rpx;overflow:hidden;padding:36rpx;position:relative}.home-diagnosis::after{border:1rpx solid hsla(0,0%,100%,.14);border-radius:50%;bottom:-100rpx;content:"";height:260rpx;position:absolute;right:-80rpx;width:260rpx}.home-diagnosis__content{margin-bottom:34rpx}.home-diagnosis__eyebrow{color:#b9d6d4;display:block;font-size:24rpx;font-weight:650}.home-diagnosis__title{display:block;font-size:42rpx;font-weight:700;line-height:1.2;margin-top:24rpx}.home-diagnosis__description{color:#dceae2;display:block;font-size:27rpx;line-height:1.6;margin-top:12rpx}.home-diagnosis .qd-button{background:#fff;color:var(--qd-primary-strong);position:relative;z-index:1}.home-context{background:var(--qd-border);border-radius:18rpx;display:flex;gap:2rpx;margin-top:28rpx;overflow:hidden}.home-context__item{background:var(--qd-surface);flex:1;min-width:0;padding:28rpx;transition:background-color .16s ease-out}.home-context__label,.home-context__meta{color:var(--qd-muted-foreground);display:block;font-size:24rpx}.home-context__value{display:block;font-size:31rpx;font-weight:650;margin:10rpx 0 6rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.home-context__meta{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.home-overview{background:var(--qd-surface);border:1rpx solid var(--qd-border);border-radius:20rpx;margin-top:28rpx;padding:28rpx}.home-overview__heading{align-items:flex-start;display:flex;gap:20rpx;justify-content:space-between}.home-overview__heading .section-title{display:block;font-size:31rpx}.home-overview__sync{color:var(--qd-muted-foreground);display:block;font-size:24rpx;margin-top:6rpx}.home-overview__link{color:var(--qd-primary);font-size:26rpx;font-weight:650;line-height:88rpx;min-height:88rpx}.home-overview__stats{display:flex;gap:12rpx;margin-top:24rpx}.home-overview__stat{background:var(--qd-surface-subtle);border-radius:14rpx;flex:1;min-width:0;padding:18rpx 16rpx}.home-overview__value{color:var(--qd-primary-strong);display:block;font-size:36rpx;font-weight:720;line-height:1.1}.home-overview__label{color:var(--qd-muted-foreground);display:block;font-size:24rpx;margin-top:8rpx}.home-list{padding:0 28rpx}.home-list__empty{color:var(--qd-muted-foreground);display:block;font-size:27rpx;padding:40rpx 0}@media screen and (max-width:380px){.home-heading{gap:12rpx}.home-heading__tools{gap:8rpx}.home-heading__status{font-size:22rpx}.home-heading__messages{padding:0 14rpx}.home-diagnosis{padding:28rpx}.home-diagnosis__title{font-size:38rpx}.home-context__item{padding:22rpx 18rpx}.home-context__value{font-size:29rpx}.home-diagnosis__description{font-size:26rpx}}.home-services{padding-bottom:16rpx}.home-services__grid{display:grid;gap:14rpx;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:18rpx}.home-service{background:var(--qd-surface);border:1rpx solid var(--qd-border);border-radius:var(--qd-radius-md);min-height:132rpx;padding:20rpx}.home-service:active{background:var(--qd-surface-subtle)}.home-service text{color:var(--qd-muted-foreground);display:block;font-size:23rpx;line-height:1.5}.home-service__title{color:var(--qd-foreground)!important;font-size:28rpx!important;font-weight:700;margin-bottom:6rpx}@media screen and (max-width:380px){.home-services__grid{grid-template-columns:1fr}}