.profile-identity{align-items:center;background:var(--qd-surface);border:1rpx solid var(--qd-border);border-radius:20rpx;display:flex;gap:22rpx;margin-top:34rpx;padding:32rpx}.profile-identity__avatar{align-items:center;background:var(--qd-primary);border-radius:50%;color:#fff;display:flex;font-size:34rpx;font-weight:700;height:88rpx;justify-content:center;width:88rpx}.profile-identity__body{flex:1;min-width:0}.profile-identity__name{display:block;font-size:34rpx;font-weight:680}.profile-identity__id{color:var(--qd-muted-foreground);display:block;font-size:24rpx;margin-top:6rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.profile-login{background:var(--qd-surface);border:1rpx solid var(--qd-border);border-radius:22rpx;margin-top:34rpx;padding:36rpx}.profile-login__title{display:block;font-size:38rpx;font-weight:700;margin-top:24rpx}.profile-login__description{color:var(--qd-muted-foreground);display:block;font-size:27rpx;margin:14rpx 0 30rpx}.profile-menu{background:var(--qd-surface);border-radius:18rpx;margin-top:34rpx;overflow:hidden}.profile-menu > view{align-items:center;border-bottom:1rpx solid var(--qd-border);display:flex;font-size:29rpx;justify-content:space-between;min-height:96rpx;padding:0 28rpx}.profile-menu > view:last-child{border-bottom:0}.profile-menu > view text:last-child{color:var(--qd-muted-foreground);font-size:25rpx}.profile-environment{align-items:center;background:var(--qd-surface-muted);border-radius:16rpx;color:var(--qd-muted-foreground);display:flex;font-size:27rpx;justify-content:space-between;margin-top:28rpx;padding:26rpx 28rpx}.profile-logout{margin-top:48rpx}@media screen and (max-width:380px){.profile-identity,.profile-login{padding:24rpx}.profile-menu > view{font-size:27rpx;padding-left:20rpx;padding-right:20rpx}}