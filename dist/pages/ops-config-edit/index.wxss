.ops-edit-page{padding-bottom:80rpx}.ops-edit-heading{min-width:0}.ops-edit-heading .page-title{display:block;overflow-wrap:anywhere}.ops-edit-meta{color:var(--qd-muted-foreground);display:flex;flex-wrap:wrap;font-size:24rpx;gap:8rpx 20rpx;line-height:1.5;margin-top:24rpx;padding:20rpx}.ops-edit-card{margin-top:20rpx;padding:24rpx}.ops-edit-label{color:var(--qd-foreground);display:flex;font-size:28rpx;font-weight:700;justify-content:space-between}.ops-edit-counter{color:var(--qd-muted-foreground);font-size:23rpx;font-weight:400}.ops-edit-textarea{background:var(--qd-surface-subtle);border:2rpx solid var(--qd-border);border-radius:14rpx;box-sizing:border-box;color:var(--qd-foreground);font-size:29rpx;line-height:1.7;margin-top:14rpx;min-height:240rpx;padding:20rpx;width:100%}.ops-edit-textarea--error{border-color:#bd343d}.ops-edit-helper,.ops-edit-validation{display:block;font-size:24rpx;line-height:1.5;margin-top:10rpx}.ops-edit-helper{color:var(--qd-muted-foreground)}.ops-edit-validation{color:#bd343d}.ops-edit-live-preview{background:var(--qd-primary-soft);border-radius:14rpx;margin-top:24rpx;padding:20rpx}.ops-edit-live-preview__label{color:var(--qd-primary);display:block;font-size:23rpx;font-weight:700}.ops-edit-live-preview__title{color:var(--qd-foreground);display:block;font-size:32rpx;font-weight:700;line-height:1.45;margin-top:10rpx;overflow-wrap:anywhere}.ops-edit-live-preview__body{color:var(--qd-ink-secondary);display:block;font-size:27rpx;line-height:1.7;margin-top:8rpx;overflow-wrap:anywhere;white-space:pre-wrap}.ops-edit-actions{align-items:center;display:flex;gap:16rpx;margin-top:26rpx}.ops-edit-actions .qd-button{flex:1;min-width:0}.ops-edit-overlay{align-items:flex-end;background:rgba(15,38,39,.42);display:flex;inset:0;position:fixed;z-index:10}.ops-edit-sheet{border-radius:26rpx 26rpx 0 0;box-sizing:border-box;padding:28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));width:100%}.ops-edit-sheet__title{color:var(--qd-foreground);display:block;font-size:36rpx;font-weight:800}.ops-edit-sheet__hint{color:var(--qd-muted-foreground);display:block;font-size:24rpx;line-height:1.6;margin-top:10rpx}@media (min-width:700px){.ops-edit-page{margin:0 auto;max-width:900rpx}}.ops-edit-redirect__hint{color:var(--qd-muted-foreground);display:block;font-size:24rpx;line-height:1.6;margin-top:20rpx;text-align:center}