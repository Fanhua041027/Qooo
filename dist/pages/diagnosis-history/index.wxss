.history-stale{align-items:center;background:var(--qd-warning-soft);border-radius:14rpx;color:#74440f;display:flex;font-size:25rpx;gap:18rpx;justify-content:space-between;line-height:1.5;margin-top:28rpx;padding:18rpx 22rpx}.history-stale__action{color:var(--qd-primary);flex:none;font-weight:700;line-height:56rpx;min-height:56rpx}.history-filter{background:var(--qd-surface-muted);border-radius:14rpx;display:flex;gap:8rpx;margin-top:28rpx;overflow-x:auto;padding:8rpx}.history-filter__item{align-items:center;border-radius:10rpx;color:var(--qd-muted-foreground);display:flex;flex:1;font-size:25rpx;gap:8rpx;justify-content:center;min-height:80rpx;min-width:120rpx;padding:0 14rpx;white-space:nowrap}.history-filter__item--active{background:var(--qd-surface);box-shadow:0 2rpx 4rpx rgba(20,40,29,.08);color:var(--qd-primary-strong);font-weight:650}.history-filter__count{color:inherit;font-size:22rpx}.history-list{margin-top:20rpx;padding:0 28rpx}