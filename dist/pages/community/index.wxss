.community-page{padding-bottom:120rpx}.community-heading{align-items:flex-start;display:flex;gap:18rpx;justify-content:space-between}.community-heading > view:first-child{flex:1;min-width:0}.community-guide{align-items:center;background:var(--qd-primary-soft);border-color:#c9e1e3;display:flex;gap:16rpx;justify-content:space-between;margin-top:24rpx;padding:20rpx}.community-guide text{color:var(--qd-ink-secondary);display:block;font-size:24rpx;line-height:1.55}.community-guide__title{color:var(--qd-primary-strong)!important;font-size:28rpx!important;font-weight:700;margin-bottom:6rpx}.community-guide__link{color:var(--qd-primary)!important;flex:none;font-weight:700}.community-tabs{border-bottom:1rpx solid var(--qd-border);display:flex;gap:26rpx;margin-top:28rpx}.community-tab{color:var(--qd-muted-foreground);font-size:27rpx;line-height:76rpx;min-height:76rpx;position:relative}.community-tab--active{color:var(--qd-primary-strong);font-weight:700}.community-tab--active::after{background:var(--qd-primary);border-radius:8rpx;bottom:-1rpx;content:"";height:5rpx;left:8rpx;position:absolute;right:8rpx}.community-list{margin-top:18rpx}.community-post{margin-top:16rpx;padding:24rpx}.community-post__head{align-items:center;display:flex;gap:14rpx}.community-avatar{align-items:center;background:var(--qd-primary-soft);border-radius:50%;color:var(--qd-primary-strong);display:flex;font-size:27rpx;font-weight:700;height:64rpx;justify-content:center;width:64rpx}.community-post__author{flex:1;min-width:0}.community-post__author text{display:block}.community-post__author text:first-child{color:var(--qd-foreground);font-size:27rpx;font-weight:700}.community-post__author text:last-child{color:var(--qd-muted-foreground);font-size:22rpx;margin-top:4rpx}.community-post__title{color:var(--qd-foreground);display:block;font-size:31rpx;font-weight:700;line-height:1.45;margin-top:20rpx}.community-post__content{color:var(--qd-ink-secondary);display:block;font-size:27rpx;line-height:1.7;margin-top:10rpx;white-space:pre-wrap}.community-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:14rpx}.community-tags text{color:var(--qd-primary);font-size:23rpx}.community-post__footer{border-top:1rpx solid var(--qd-border);color:var(--qd-muted-foreground);display:flex;font-size:23rpx;gap:28rpx;margin-top:20rpx;padding-top:16rpx}.community-post__footer text:first-child{color:var(--qd-primary)}.community-post__liked{font-weight:700}.community-overlay{align-items:flex-end;background:var(--qd-overlay);display:flex;inset:0;position:fixed;z-index:var(--qd-z-modal)}.community-sheet{background:var(--qd-surface);border-radius:24rpx 24rpx 0 0;padding:28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));width:100%}.community-sheet__title{display:block;font-size:36rpx;font-weight:700}.community-input,.community-textarea{background:var(--qd-surface-subtle);border:1rpx solid var(--qd-border);border-radius:var(--qd-radius-md);box-sizing:border-box;color:var(--qd-foreground);font-size:27rpx;line-height:1.6;margin-top:16rpx;padding:18rpx 20rpx;width:100%}.community-textarea{min-height:180rpx}.community-sheet__hint{color:var(--qd-muted-foreground);display:block;font-size:22rpx;line-height:1.5;margin-top:10rpx}.community-sheet__actions{display:flex;gap:14rpx;margin-top:22rpx}.community-sheet__actions .qd-button:first-child{flex:0 0 auto}.community-sheet__actions .qd-button:last-child{flex:1}