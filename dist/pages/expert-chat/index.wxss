.expert-chat-page{padding-bottom:120rpx}.expert-heading{align-items:flex-start;display:flex}.expert-safety{background:var(--qd-warning-soft);border-color:#ecd6a8;margin-top:24rpx;padding:20rpx}.expert-safety text{color:#70420f;display:block;font-size:24rpx;line-height:1.55}.expert-safety text:first-child{font-size:28rpx;font-weight:700}.expert-safety text:last-child{margin-top:8rpx}.expert-list{margin-top:18rpx}.expert-item{margin-top:16rpx;padding:24rpx}.expert-item__head{align-items:center;display:flex;gap:14rpx}.expert-avatar{align-items:center;background:var(--qd-primary-soft);border-radius:50%;color:var(--qd-primary-strong);display:flex;font-size:31rpx;font-weight:700;height:72rpx;justify-content:center;width:72rpx}.expert-item__identity{flex:1;min-width:0}.expert-item__identity text{display:block}.expert-item__identity text:first-child{font-size:30rpx;font-weight:700}.expert-item__identity text:last-child{color:var(--qd-muted-foreground);font-size:23rpx;margin-top:5rpx}.expert-item__specialty{color:var(--qd-foreground);display:block;font-size:27rpx;font-weight:650;margin-top:20rpx}.expert-item__meta{margin-top:8rpx}.expert-item__meta text{color:var(--qd-muted-foreground);display:block;font-size:23rpx;line-height:1.55}.expert-item__footer{align-items:center;border-top:1rpx solid var(--qd-border);display:flex;gap:16rpx;justify-content:space-between;margin-top:18rpx;padding-top:16rpx}.expert-item__footer > text{color:var(--qd-primary);font-size:23rpx}.chat-header{align-items:center;border-bottom:1rpx solid var(--qd-border);display:flex;gap:14rpx;min-height:92rpx;padding-bottom:18rpx}.chat-back{align-items:center;color:var(--qd-primary);display:flex;font-size:23rpx;min-height:64rpx;padding:0 14rpx}.chat-header > view:nth-child(2){flex:1;min-width:0}.chat-header__name,.chat-header__status{display:block}.chat-header__name{font-size:31rpx;font-weight:700}.chat-header__status{color:var(--qd-muted-foreground);font-size:22rpx;margin-top:4rpx}.chat-notice{background:var(--qd-surface-muted);border-radius:var(--qd-radius-md);color:var(--qd-muted-foreground);font-size:23rpx;line-height:1.55;margin-top:16rpx;padding:16rpx 18rpx}.chat-messages{margin-top:20rpx;min-height:720rpx;padding-bottom:140rpx}.chat-message{border-radius:18rpx;font-size:27rpx;line-height:1.65;margin-top:16rpx;max-width:82%;padding:18rpx 20rpx}.chat-message text{display:block}.chat-message--user{background:var(--qd-primary);border-radius:18rpx 18rpx 4rpx 18rpx;color:#fff;margin-left:auto}.chat-message--expert{background:var(--qd-surface);border:1rpx solid var(--qd-border);border-radius:18rpx 18rpx 18rpx 4rpx;color:var(--qd-foreground);margin-right:auto}.chat-message--system{color:var(--qd-muted-foreground);font-size:22rpx;margin:16rpx 0;max-width:100%;padding:12rpx 0;text-align:center}.chat-composer{background:hsla(0,0%,100%,.98);border-top:1rpx solid var(--qd-border);bottom:0;display:flex;gap:12rpx;left:0;padding:14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));position:fixed;right:0;z-index:var(--qd-z-sticky)}.chat-composer input{background:var(--qd-surface-subtle);border:1rpx solid var(--qd-border);border-radius:999rpx;flex:1;font-size:26rpx;min-height:76rpx;min-width:0;padding:0 20rpx}.chat-composer .qd-button{min-width:132rpx}