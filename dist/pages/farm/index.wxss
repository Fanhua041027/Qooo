.farm-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.farm-heading .qd-button {
  margin-top: 8rpx;
}

.farm-form {
  margin-top: 30rpx;
  padding: 28rpx;
}

.farm-form__submit {
  margin-top: 30rpx;
}

.farm-stale {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: var(--qd-warning-soft);
  color: #74440f;
  font-size: 25rpx;
  line-height: 1.5;
}

.farm-stale__action {
  flex: none;
  min-height: 56rpx;
  color: var(--qd-primary);
  font-weight: 700;
  line-height: 56rpx;
}

.farm-list {
  margin-top: 32rpx;
}

.farm-card {
  margin-bottom: 20rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: var(--qd-surface);
}

.farm-card__main {
  min-width: 0;
}

.farm-card__actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--qd-border);
}

.farm-card__actions .qd-button {
  min-width: 0;
  flex: 1;
  padding: 0 12rpx;
  font-size: 25rpx;
}

.farm-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.farm-card__name {
  font-size: 34rpx;
  font-weight: 680;
}

.farm-card__score {
  color: var(--qd-primary);
  font-size: 25rpx;
  font-weight: 600;
}

.farm-card__location {
  display: block;
  margin-top: 10rpx;
  color: var(--qd-muted-foreground);
  font-size: 26rpx;
}

.farm-card__stats {
  display: flex;
  gap: 28rpx;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--qd-border);
  color: #345343;
  font-size: 27rpx;
}
