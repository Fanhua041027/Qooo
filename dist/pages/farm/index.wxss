.farm-heading{align-items:flex-start;display:flex;gap:24rpx;justify-content:space-between}.farm-heading .qd-button{margin-top:8rpx}.farm-form{margin-top:30rpx;padding:28rpx}.farm-form__submit{margin-top:30rpx}.farm-stale{align-items:center;background:var(--qd-warning-soft);border-radius:14rpx;color:#74440f;display:flex;font-size:25rpx;gap:18rpx;justify-content:space-between;line-height:1.5;margin-top:24rpx;padding:18rpx 22rpx}.farm-stale__action{color:var(--qd-primary);flex:none;font-weight:700;line-height:56rpx;min-height:56rpx}.farm-list{margin-top:32rpx}.farm-card{background:var(--qd-surface);border:1rpx solid var(--qd-border);border-radius:20rpx;margin-bottom:20rpx;padding:32rpx;transition:background-color .16s ease-out}.farm-card__main{min-width:0}.farm-card__actions{border-top:1rpx solid var(--qd-border);display:flex;gap:12rpx;margin-top:18rpx;padding-top:16rpx}.farm-card__actions .qd-button{flex:1;font-size:25rpx;min-width:0;padding:0 12rpx}.farm-card__top{align-items:center;display:flex;gap:20rpx;justify-content:space-between}.farm-card__name{font-size:34rpx;font-weight:680}.farm-card__score{color:var(--qd-primary);font-size:25rpx;font-weight:600}.farm-card__location{color:var(--qd-muted-foreground);display:block;font-size:26rpx;margin-top:10rpx}.farm-card__stats{border-top:1rpx solid var(--qd-border);color:#345343;display:flex;font-size:27rpx;gap:28rpx;margin-top:26rpx;padding-top:22rpx}@media screen and (max-width:380px){.farm-heading{gap:12rpx}.farm-heading .qd-button{font-size:27rpx;padding:0 22rpx}.farm-card{padding:24rpx}.farm-card__name{font-size:31rpx}}