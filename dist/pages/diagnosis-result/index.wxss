}

.result-follow-up__question text {
  display: block;
}

.result-follow-up__question text + text {
  margin-top: 8rpx;
  color: var(--qd-muted-foreground);
  font-size: 26rpx;
}

.result-summary {
  padding: 36rpx;
  border-radius: 24rpx;
  background: var(--qd-surface);
  box-shadow: 0 6rpx 12rpx rgba(20, 40, 29, 0.07);
}

.result-summary__top {
  display: flex;
  justify-content: space-between;
}

.result-summary__crop {
  display: block;
  margin-top: 34rpx;
  color: var(--qd-muted-foreground);
  font-size: 27rpx;
}

.result-summary__issue {
  display: block;
  margin-top: 8rpx;
  font-size: 46rpx;
  font-weight: 720;
  line-height: 1.25;
}

.result-summary__confidence {
  display: block;
  margin-top: 14rpx;
