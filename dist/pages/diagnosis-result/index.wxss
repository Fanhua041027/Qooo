  font-size: 28rpx;
  font-weight: 650;
}

.result-summary__reason {
  display: block;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--qd-border);
  color: var(--qd-muted-foreground);
  font-size: 28rpx;
}

.expert-review-callout {
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border-radius: 18rpx;
  background: var(--qd-accent-soft);
  color: var(--qd-foreground);
  font-size: 27rpx;
  line-height: 1.65;
}

.expert-review-callout__title {
  display: block;
  margin-bottom: 6rpx;
  color: var(--qd-warning);
  font-size: 29rpx;
  font-weight: 700;
}

.result-safety-callout {
  margin-top: 20rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid #edc6c1;
  border-radius: 18rpx;
  background: var(--qd-danger-soft);
  color: var(--qd-foreground);
  font-size: 27rpx;
  line-height: 1.65;
}

.result-safety-callout__title {
  display: block;
  margin-bottom: 6rpx;
  color: var(--qd-danger);
  font-size: 29rpx;
  font-weight: 700;
}

.result-safety-callout__codes {
  display: block;
  margin-top: 10rpx;
  color: var(--qd-danger);
  font-size: 24rpx;
}

.result-evidence {
  margin-top: 18rpx;
}

.result-evidence__item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--qd-border);
  color: #294537;
  font-size: 28rpx;
}

.result-evidence__index {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--qd-surface-muted);
  color: var(--qd-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.result-actions {
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: var(--qd-surface);
}

.result-action {
  padding: 28rpx;
  border-bottom: 1rpx solid var(--qd-border);
}

.result-action:last-child {
  border-bottom: 0;
}

.result-action__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--qd-muted-foreground);
  font-size: 23rpx;
}

.result-action__title {
  display: block;
  margin-top: 16rpx;
  font-size: 31rpx;
  font-weight: 650;
}

.result-action__description {
  display: block;
  margin-top: 8rpx;
  color: var(--qd-muted-foreground);
  font-size: 27rpx;
}

.result-trace {
  margin-top: 40rpx;
  padding: 26rpx;
  border-radius: 14rpx;
  background: var(--qd-surface-muted);
  color: var(--qd-muted-foreground);
  font-size: 23rpx;
}

.result-trace text {
  display: block;
  margin-top: 8rpx;
}

@keyframes result-spin {
  to {
    transform: rotate(360deg);
  }
}
@media (prefers-reduced-motion: reduce) {
  .result-processing__indicator view {
    animation: none;
  }
  .result-processing__track view {
    transition: none;
  }
}
