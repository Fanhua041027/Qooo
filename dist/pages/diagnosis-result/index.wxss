.result-processing {
  display: flex;
  min-height: 76vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.result-processing__indicator {
  display: flex;
  width: 132rpx;
  height: 132rpx;
  margin-bottom: 32rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--qd-primary-soft);
}

.result-processing__indicator view {
  width: 46rpx;
  height: 46rpx;
  border: 7rpx solid #a7c5c8;
  border-top-color: var(--qd-primary);
  border-radius: 50%;
  animation: result-spin 1s linear infinite;
}

.result-processing__title {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.result-processing__description {
  max-width: 600rpx;
  margin-top: 14rpx;
  color: var(--qd-muted-foreground);
  font-size: 28rpx;
}

.result-processing__track {
  width: 100%;
  height: 10rpx;
  margin-top: 48rpx;
  overflow: hidden;
  border-radius: 99rpx;
  background: var(--qd-surface-muted);
}

.result-processing__track view {
  width: 100%;
  height: 100%;
  border-radius: inherit;
  background: var(--qd-primary);
  transform: scaleX(0.45);
  transform-origin: left center;
  transition: transform 250ms ease-out;
}

.result-processing__hint {
  margin-top: 16rpx;
  color: var(--qd-muted-foreground);
  font-size: 24rpx;
}

.result-processing__recovery {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  margin-top: 28rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--qd-accent-soft);
  color: var(--qd-foreground);
  font-size: 26rpx;
  line-height: 1.6;
}

.result-follow-up {
  padding-top: 72rpx;
}

.result-follow-up__title {
  display: block;
  margin-top: 24rpx;
  font-size: 42rpx;
  font-weight: 720;
