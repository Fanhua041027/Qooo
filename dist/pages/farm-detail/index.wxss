.farm-detail-heading{align-items:flex-start;display:flex;gap:20rpx;justify-content:space-between}.farm-detail-heading .qd-button{margin-top:8rpx}.plot-form{margin-top:32rpx;padding:28rpx}.plot-form__date{margin:28rpx 0}.plot-form__date > text{display:block;font-size:27rpx;font-weight:600;margin-bottom:12rpx}.plot-form__date picker view{background:#fff;border:1rpx solid var(--qd-border);border-radius:14rpx;min-height:88rpx;padding:22rpx 26rpx}.plot-list{background:var(--qd-surface);border-radius:18rpx;margin-top:34rpx;overflow:hidden}.plot-row{align-items:center;border-bottom:1rpx solid var(--qd-border);display:flex;gap:24rpx;padding:30rpx}.plot-row:last-child{border-bottom:0}.plot-row__crop{align-items:center;background:var(--qd-primary-soft);border-radius:14rpx;color:var(--qd-primary);display:flex;flex:0 0 auto;font-size:34rpx;font-weight:700;height:82rpx;justify-content:center;width:82rpx}.plot-row__body{min-width:0}.plot-row__name{display:block;font-size:31rpx;font-weight:650}.plot-row__meta{color:var(--qd-muted-foreground);display:block;font-size:25rpx;margin-top:8rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.plot-row__actions{display:flex;gap:12rpx;margin-top:12rpx}.plot-row__actions .qd-button{font-size:24rpx;min-height:72rpx;min-width:0;padding:0 18rpx}