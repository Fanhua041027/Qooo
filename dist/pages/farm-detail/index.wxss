.farm-detail-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.farm-detail-heading .qd-button {
  margin-top: 8rpx;
}

.plot-form {
  margin-top: 32rpx;
  padding: 28rpx;
}

.plot-form__date {
  margin: 28rpx 0;
}

.plot-form__date > text {
  display: block;
  margin-bottom: 12rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.plot-form__date picker view {
  min-height: 88rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid var(--qd-border);
  border-radius: 14rpx;
  background: #fff;
}

.plot-list {
  margin-top: 34rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: var(--qd-surface);
}

.plot-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--qd-border);
}

.plot-row:last-child {
  border-bottom: 0;
}

.plot-row__crop {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: var(--qd-primary-soft);
  color: var(--qd-primary);
  font-size: 34rpx;
  font-weight: 700;
}

.plot-row__body {
  min-width: 0;
}

.plot-row__name {
  display: block;
  font-size: 31rpx;
  font-weight: 650;
}

.plot-row__meta {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--qd-muted-foreground);
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plot-row__actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.plot-row__actions .qd-button {
  min-width: 0;
  min-height: 72rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
}
