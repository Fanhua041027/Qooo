.messages-page{padding-top:24rpx}.messages-heading{align-items:flex-start;display:flex;gap:16rpx;justify-content:space-between}.messages-heading .qd-button{flex:none;font-size:26rpx;min-height:88rpx;padding:0 16rpx}.messages-list{margin-top:32rpx}.messages-stale{align-items:center;background:var(--qd-accent-soft);border-radius:14rpx;color:var(--qd-warning);display:flex;font-size:25rpx;gap:18rpx;justify-content:space-between;line-height:1.5;margin-bottom:20rpx;padding:18rpx 22rpx}.messages-stale__action{color:var(--qd-primary);flex:none;font-weight:700;line-height:56rpx;min-height:56rpx}.message-item{align-items:flex-start;background:var(--qd-surface);border-radius:18rpx;display:flex;gap:18rpx;margin-bottom:16rpx;padding:24rpx;transition:background-color .18s ease-out,opacity .18s ease-out}.message-item:active{opacity:.78}.message-item--unread{background:#fbfdfd}.message-item__mark{align-items:center;background:var(--qd-surface-muted);border-radius:16rpx;color:var(--qd-muted-foreground);display:flex;flex:0 0 auto;font-size:22rpx;font-weight:700;height:64rpx;justify-content:center;width:64rpx}.message-item__mark--DIAGNOSIS_COMPLETED{background:var(--qd-primary-soft);color:var(--qd-primary-strong)}.message-item__mark--TASK_DUE,.message-item__mark--TASK_OVERDUE{background:var(--qd-accent-soft);color:var(--qd-warning)}.message-item__mark--DIAGNOSIS_FAILED{background:#fbe9eb;color:var(--qd-danger)}.message-item__body{flex:1;min-width:0}.message-item__top{align-items:flex-start;display:flex;gap:12rpx;justify-content:space-between}.message-item__title{font-size:30rpx;font-weight:680;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.message-item__type{color:var(--qd-muted-foreground);display:block;font-size:23rpx;margin-top:6rpx}.message-item__content{color:var(--qd-foreground);display:block;font-size:27rpx;line-height:1.6;margin-top:12rpx}.message-item__arrow{align-self:center;color:var(--qd-primary);flex:none;font-size:44rpx;line-height:1}