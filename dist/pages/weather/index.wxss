.weather-page{padding-bottom:120rpx}.weather-heading,.weather-section-heading{align-items:flex-start;display:flex;gap:20rpx;justify-content:space-between}.weather-heading__meta{align-items:flex-end;color:var(--qd-muted-foreground);display:flex;flex-direction:column;font-size:21rpx;gap:8rpx;white-space:nowrap}.weather-location-detail{color:var(--qd-muted-foreground);display:block;font-size:23rpx;line-height:1.5;margin-top:6rpx}.weather-empty{display:flex;flex-direction:column;justify-content:center;min-height:70vh}.weather-empty .page-description{margin-bottom:32rpx}.weather-empty__error{color:var(--qd-danger);display:block;font-size:24rpx;margin-top:18rpx}.weather-region-picker{align-items:center;background:var(--qd-surface);border:1rpx solid var(--qd-border);border-radius:var(--qd-radius-md);color:var(--qd-primary-strong);display:flex;font-size:30rpx;font-weight:700;gap:20rpx;justify-content:space-between;min-height:104rpx;padding:0 26rpx}.weather-region-picker__arrow{color:var(--qd-muted-foreground);font-size:23rpx;font-weight:400}.weather-heading > view{flex:1;min-width:0}.weather-current{background:var(--qd-primary-strong);border:0;color:#fff;margin-top:28rpx;padding:28rpx}.weather-current__top{align-items:flex-start;display:flex;justify-content:space-between}.weather-current__condition,.weather-current__feels{display:block}.weather-current__condition{font-size:34rpx;font-weight:700}.weather-current__feels{color:#d9eeee;font-size:24rpx;margin-top:8rpx}.weather-current__temperature{align-items:flex-start;display:flex;margin-top:14rpx}.weather-current__temperature text:first-child{font-size:104rpx;font-weight:700;letter-spacing:-3rpx;line-height:1}.weather-current__temperature text:last-child{font-size:34rpx;margin-top:12rpx}.weather-symbol{align-items:center;background:var(--qd-accent-soft);border-radius:50%;color:var(--qd-accent);display:inline-flex;font-size:25rpx;font-weight:700;height:64rpx;justify-content:center;width:64rpx}.weather-current .weather-symbol{background:hsla(0,0%,100%,.14);color:#fff;font-size:32rpx;height:96rpx;width:96rpx}.weather-symbol--rain{background:#e7f1fb;color:#246aa5}.weather-symbol--sun{background:#fff0d9;color:#9b5b12}.weather-metrics{border-top:1rpx solid hsla(0,0%,100%,.2);display:flex;gap:18rpx;margin-top:28rpx;padding-top:22rpx}.weather-metrics view{flex:1;min-width:0}.weather-metrics text{display:block}.weather-metrics text:first-child{font-size:25rpx;font-weight:700}.weather-metrics text:last-child{color:#c7dfdf;font-size:22rpx;margin-top:6rpx}.weather-alert{align-items:flex-start;background:var(--qd-warning-soft);border:1rpx solid #ecd6a8;border-radius:var(--qd-radius-md);color:#70420f;display:flex;gap:16rpx;justify-content:space-between;margin-top:18rpx;padding:20rpx}.weather-alert--error{background:var(--qd-danger-soft);border-color:#e8b9be;color:#8d252d}.weather-alert__content,.weather-alert__title{display:block}.weather-alert__title{font-weight:700}.weather-alert__content{font-size:25rpx;line-height:1.6;margin-top:6rpx}.weather-alert__action{align-self:center;flex:none;font-weight:700;line-height:56rpx;min-height:56rpx}.weather-section-heading{align-items:baseline}.weather-section-heading__hint{color:var(--qd-muted-foreground);font-size:22rpx}.weather-forecast{display:flex;margin-top:16rpx;overflow-x:auto;padding:22rpx 8rpx}.weather-day{min-width:144rpx;padding:0 12rpx;text-align:center}.weather-day + .weather-day{border-left:1rpx solid var(--qd-border)}.weather-day text{display:block}.weather-day__date{color:var(--qd-foreground);font-size:25rpx;font-weight:700}.weather-day .weather-symbol{margin:16rpx auto 10rpx}.weather-day__condition{font-size:24rpx}.weather-day__temp{font-weight:700;margin-top:12rpx}.weather-day__rain,.weather-day__wind{color:var(--qd-muted-foreground);font-size:21rpx;margin-top:8rpx;white-space:nowrap}.weather-action-grid{display:flex;gap:16rpx;margin-top:16rpx}.weather-action{background:var(--qd-surface);border:1rpx solid var(--qd-border);border-radius:var(--qd-radius-md);flex:1;min-height:150rpx;padding:22rpx}.weather-action:active{background:var(--qd-surface-subtle)}.weather-action text{color:var(--qd-muted-foreground);display:block;font-size:24rpx;line-height:1.55}.weather-action__title{color:var(--qd-foreground)!important;font-size:29rpx!important;font-weight:700;margin-bottom:8rpx}.weather-history__list{margin-top:16rpx;padding:0 22rpx}.weather-history__row{align-items:center;border-bottom:1rpx solid var(--qd-border);display:flex;gap:18rpx;justify-content:space-between;min-height:96rpx}.weather-history__row:last-child{border-bottom:0}.weather-history__row text{display:block;font-size:24rpx}.weather-history__row text + text{color:var(--qd-muted-foreground);font-size:21rpx;margin-top:4rpx}.weather-history__row view:last-child{text-align:right}.weather-history__empty{border:1rpx dashed var(--qd-border);border-radius:var(--qd-radius-md);color:var(--qd-muted-foreground);display:block;font-size:24rpx;line-height:1.6;margin-top:16rpx;padding:20rpx}