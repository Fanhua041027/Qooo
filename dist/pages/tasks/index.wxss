.tasks-overview{display:flex;gap:12rpx;margin-top:28rpx}.tasks-overview > view{background:var(--qd-surface);border:1rpx solid var(--qd-border);border-radius:16rpx;flex:1;min-width:0;padding:20rpx}.tasks-overview__value{color:var(--qd-primary-strong);display:block;font-size:36rpx;font-weight:720;line-height:1.1}.tasks-overview__value--warning{color:var(--qd-danger)}.tasks-overview__label{color:var(--qd-muted-foreground);display:block;font-size:24rpx;margin-top:8rpx}.tasks-filter{background:var(--qd-surface-muted);border-radius:14rpx;display:flex;gap:8rpx;margin-top:28rpx;padding:8rpx}.tasks-filter view{align-items:center;border-radius:10rpx;color:var(--qd-muted-foreground);display:flex;flex:1;font-size:25rpx;font-weight:600;gap:8rpx;justify-content:center;min-height:88rpx;padding:18rpx 8rpx;text-align:center;white-space:nowrap}.tasks-filter__active{background:var(--qd-surface);box-shadow:0 2rpx 4rpx rgba(20,40,29,.08);color:var(--qd-primary-strong)!important}.tasks-filter__count{color:inherit;font-size:22rpx}.tasks-filter view:nth-child(2) .tasks-filter__count{color:var(--qd-danger)}.tasks-stale{align-items:center;background:var(--qd-warning-soft);border-radius:14rpx;color:#74440f;display:flex;font-size:25rpx;gap:18rpx;justify-content:space-between;line-height:1.5;margin-top:24rpx;padding:18rpx 22rpx}.tasks-stale__action{color:var(--qd-primary);flex:none;font-weight:700;line-height:88rpx;min-height:88rpx}.tasks-list{margin-top:26rpx;padding:0 28rpx}@media screen and (max-width:380px){.tasks-overview > view{padding:16rpx 12rpx}.tasks-overview__value{font-size:32rpx}.tasks-filter view{font-size:23rpx}.tasks-list{padding-left:20rpx;padding-right:20rpx}}