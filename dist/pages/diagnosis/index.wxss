.diagnosis-page{padding-bottom:calc(260rpx + env(safe-area-inset-bottom));padding-top:24rpx}.diagnosis-page .fixed-footer{bottom:calc(112rpx + env(safe-area-inset-bottom));z-index:var(--qd-z-modal,40)}.diagnosis-steps{border-bottom:1rpx solid var(--qd-border);border-top:1rpx solid var(--qd-border);display:flex;margin-top:36rpx;padding:22rpx 0}.diagnosis-step{align-items:center;color:var(--qd-muted-foreground);display:flex;flex:1;font-size:25rpx;gap:12rpx}.diagnosis-step text:first-child{align-items:center;background:var(--qd-surface-muted);border-radius:50%;display:flex;height:40rpx;justify-content:center;width:40rpx}.diagnosis-step--active{color:var(--qd-primary);font-weight:650}.diagnosis-step--active text:first-child{background:var(--qd-primary);color:#fff}.diagnosis-step--done{color:var(--qd-success);font-weight:650}.diagnosis-step--done text:first-child{background:var(--qd-success-soft);color:var(--qd-success)}.diagnosis-form{margin-top:20rpx;padding:4rpx 28rpx 28rpx}.diagnosis-picker{margin-top:24rpx}.diagnosis-picker__label{display:block;font-size:27rpx;font-weight:600;margin-bottom:12rpx}.diagnosis-picker__value{border:1rpx solid var(--qd-border);border-radius:14rpx;color:var(--qd-foreground);min-height:88rpx;padding:22rpx 26rpx}.diagnosis-crop-options{margin-top:20rpx}.diagnosis-crop-options__label{color:var(--qd-muted-foreground);display:block;font-size:24rpx}.diagnosis-crop-options__list{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:12rpx}.diagnosis-crop-option{border:1rpx solid var(--qd-border);border-radius:999rpx;color:var(--qd-ink-secondary);font-size:25rpx;line-height:88rpx;min-height:88rpx;padding:0 20rpx}.diagnosis-crop-option--selected{background:var(--qd-primary-soft);border-color:var(--qd-primary);color:var(--qd-primary-strong);font-weight:650}.diagnosis-form__hint{color:var(--qd-muted-foreground);display:block;font-size:23rpx;line-height:1.5;margin-top:10rpx}.diagnosis-upload{align-items:center;background:var(--qd-surface);border:2rpx dashed #9ab5b7;border-radius:20rpx;display:flex;flex-direction:column;justify-content:center;margin-top:20rpx;min-height:330rpx;padding:36rpx;text-align:center;transition:background-color .16s ease-out,border-color .16s ease-out}.diagnosis-upload:active{background:var(--qd-primary-soft);border-color:var(--qd-primary)}.diagnosis-upload__focus{background:var(--qd-primary-soft);border:5rpx solid var(--qd-primary);border-radius:14rpx;box-shadow:inset 0 0 0 10rpx #fff;height:64rpx;margin-bottom:24rpx;width:64rpx}.diagnosis-upload__title{font-size:32rpx;font-weight:650}.diagnosis-upload__description{color:var(--qd-muted-foreground);font-size:25rpx;margin-top:10rpx}.diagnosis-preview{display:flex;gap:24rpx;margin-top:20rpx;padding:24rpx}.diagnosis-preview__image{background:var(--qd-surface-muted);border-radius:14rpx;flex:0 0 auto;height:230rpx;width:210rpx}.diagnosis-preview__body{flex:1;min-width:0}.diagnosis-preview__quality{margin-top:18rpx}.diagnosis-preview__quality-top{align-items:center;color:var(--qd-muted-foreground);display:flex;font-size:23rpx;justify-content:space-between}.diagnosis-preview__quality-top text:last-child{color:var(--qd-primary-strong);font-weight:700}.diagnosis-preview__quality-track{background:var(--qd-surface-muted);border-radius:99rpx;height:8rpx;margin-top:8rpx;overflow:hidden}.diagnosis-preview__quality-track view{background:var(--qd-success);border-radius:inherit;height:100%;transform:scaleX(0);transform-origin:left center;transition:transform .22s ease-out;width:100%}.diagnosis-preview__quality-track--warning view{background:var(--qd-warning)}.diagnosis-preview__quality-track--failed view{background:var(--qd-danger)}.diagnosis-preview__issue,.diagnosis-preview__meta{color:var(--qd-muted-foreground);display:block;font-size:24rpx;margin-top:12rpx}.diagnosis-preview__issue{color:var(--qd-warning)}.diagnosis-preview__actions{color:var(--qd-primary);display:flex;font-size:26rpx;font-weight:600;gap:28rpx;margin-top:16rpx}.diagnosis-preview__actions text{align-items:center;display:flex;min-height:88rpx}.diagnosis-tips{background:var(--qd-primary-soft);border-radius:16rpx;color:#2f5558;font-size:26rpx;margin-top:36rpx;padding:28rpx}.diagnosis-tips text{display:block;margin-top:10rpx}.diagnosis-tips__title{color:var(--qd-primary-strong);font-size:29rpx;font-weight:650;margin-top:0!important}.diagnosis-tip-row{align-items:flex-start;display:flex;gap:14rpx}.diagnosis-tip-row__index{align-items:center;background:var(--qd-primary);border-radius:50%;color:#fff;display:flex;flex:0 0 auto;font-size:22rpx;height:38rpx;justify-content:center;line-height:38rpx;margin-top:12rpx;width:38rpx}.diagnosis-tip-row text:last-child{flex:1}.diagnosis-progress{background:var(--qd-surface-muted);border-radius:99rpx;height:6rpx;margin-bottom:16rpx;overflow:hidden}.diagnosis-progress__bar{background:var(--qd-primary);border-radius:inherit;height:100%;transform:scaleX(0);transform-origin:left center;transition:transform .22s ease-out;width:100%}@media screen and (max-width:380px){.diagnosis-step{font-size:23rpx;gap:8rpx}.diagnosis-step text:first-child{height:36rpx;width:36rpx}.diagnosis-form{padding-left:20rpx;padding-right:20rpx}.diagnosis-preview{gap:16rpx;padding:18rpx}.diagnosis-preview__image{height:200rpx;width:176rpx}}